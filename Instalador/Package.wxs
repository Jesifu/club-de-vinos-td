<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui"
     xmlns:sql="http://wixtoolset.org/schemas/v4/wxs/sql">

  <Package Name="Club de Vinos"
           Manufacturer="Club de Vinos"
           Version="1.5.0.0"
           UpgradeCode="7C1F3A52-9B0E-4D6A-8E21-5A4D0C9B7E13"
           Language="3082"
           Codepage="1252"
           Scope="perMachine"
           Compressed="yes">

    <MajorUpgrade DowngradeErrorMessage="!(loc.DowngradeError)" />
    <MediaTemplate EmbedCab="yes" />

    <!-- Icon for the shortcuts and the "Apps & features" entry. -->
    <Icon Id="AppIcon.ico" SourceFile="..\CAPAS\Resources\ClubDeVinos.ico" />
    <Property Id="ARPPRODUCTICON" Value="AppIcon.ico" />

    <!-- Dialog set with install directory selection. The license page is skipped (see UI below). -->
    <Property Id="WIXUI_INSTALLDIR" Value="INSTALLFOLDER" />

    <!-- SQL Server instance chosen in SqlInstanceDlg ("." = default local instance, ".\NAME" = named instance). -->
    <!--
      No static default on purpose: a static Value="." would be indistinguishable from a user choice and would
      overwrite the instance stored by a previous install on silent upgrade/repair. The effective default is
      resolved by the SetProperty actions below (command line / dialog > stored registry value > ".").
    -->
    <Property Id="SQLINSTANCE" Secure="yes" />

    <!-- Instance stored by a previous install (64-bit view), loaded by AppSearch. -->
    <Property Id="SQLINSTANCE_PREV" Secure="yes">
      <RegistrySearch Id="SqlInstancePrevSearch" Root="HKLM" Key="Software\Club de Vinos"
                      Name="SqlInstance" Type="raw" Bitness="always64" />
    </Property>

    <!-- Applied only while SQLINSTANCE is still empty (not on the command line, not typed in the dialog). -->
    <SetProperty Id="SQLINSTANCE" Action="SetSqlInstancePrevUI" Value="[SQLINSTANCE_PREV]" Sequence="ui"
                 After="AppSearch" Condition="NOT SQLINSTANCE AND SQLINSTANCE_PREV" />
    <SetProperty Id="SQLINSTANCE" Action="SetSqlInstanceDefaultUI" Value="." Sequence="ui"
                 After="SetSqlInstancePrevUI" Condition="NOT SQLINSTANCE" />
    <SetProperty Id="SQLINSTANCE" Action="SetSqlInstancePrevExec" Value="[SQLINSTANCE_PREV]" Sequence="execute"
                 After="AppSearch" Condition="NOT SQLINSTANCE AND SQLINSTANCE_PREV" />
    <SetProperty Id="SQLINSTANCE" Action="SetSqlInstanceDefaultExec" Value="." Sequence="execute"
                 After="SetSqlInstancePrevExec" Condition="NOT SQLINSTANCE" />

    <!-- The ComboBox table is not part of WixUI_InstallDir; the custom action inserts temporary rows into it. -->
    <EnsureTable Id="ComboBox" />

    <!-- "1" when the user chose to install only the application files (no database now). -->
    <Property Id="SQLSKIPDB" Secure="yes" />

    <!-- Localized messages used by the custom actions ({0}, {1} are filled in by the C# code). -->
    <Property Id="SQLMSG_EMPTY" Value="!(loc.SqlMsg_Empty)" />
    <Property Id="SQLMSG_STARTFAIL" Value="!(loc.SqlMsg_StartFail)" />
    <Property Id="SQLMSG_STARTFAILRETRY" Value="!(loc.SqlMsg_StartFailRetry)" />
    <Property Id="SQLMSG_NOSERVICE" Value="!(loc.SqlMsg_NoService)" />
    <Property Id="SQLMSG_CONNFAIL" Value="!(loc.SqlMsg_ConnFail)" />
    <Property Id="SQLMSG_CONNFAILRETRY" Value="!(loc.SqlMsg_ConnFailRetry)" />

    <!-- Managed (DTF) custom actions: SQL Server detection, service start and connection check. -->
    <Binary Id="CustomActionsDll" SourceFile="$(var.CustomActions.TargetDir)CustomActions.CA.dll" />
    <CustomAction Id="DetectSqlInstances" BinaryRef="CustomActionsDll"
                  DllEntry="DetectSqlInstances" Execute="immediate" Return="check" />
    <CustomAction Id="ValidateSqlInstance" BinaryRef="CustomActionsDll"
                  DllEntry="ValidateSqlInstance" Execute="immediate" Return="check" />
    <CustomAction Id="PrepareSqlService" BinaryRef="CustomActionsDll"
                  DllEntry="PrepareSqlService" Execute="immediate" Return="check" />
    <!-- Elevated: starts the local SQL service (retry/cancel prompt on failure) before any file is copied. -->
    <CustomAction Id="EnsureSqlService" BinaryRef="CustomActionsDll"
                  DllEntry="EnsureSqlService" Execute="deferred" Impersonate="no" Return="check" />

    <!-- Runs before the dialogs are shown (WelcomeDlg is scheduled after MigrateFeatureStates). -->
    <InstallUISequence>
      <Custom Action="DetectSqlInstances" Before="CostInitialize" Condition="NOT Installed" />
    </InstallUISequence>

    <InstallExecuteSequence>
      <Custom Action="PrepareSqlService" Before="InstallInitialize" Condition="NOT Installed AND NOT SQLSKIPDB" />
      <Custom Action="EnsureSqlService" Before="InstallFiles" Condition="NOT Installed AND NOT SQLSKIPDB" />
    </InstallExecuteSequence>

    <UI>
      <ui:WixUI Id="WixUI_InstallDir" />
      <Publish Dialog="WelcomeDlg" Control="Next" Event="NewDialog" Value="InstallDirDlg"
               Order="2" Condition="NOT Installed" />
      <Publish Dialog="InstallDirDlg" Control="Back" Event="NewDialog" Value="WelcomeDlg"
               Order="2" />

      <!--
        SqlInstanceDlg goes between InstallDirDlg and VerifyReadyDlg. WiX 7's WixUI_InstallDir
        publishes, on InstallDirDlg.Next: CheckTargetPath (1), SetTargetPath (3) and an unconditional
        NewDialog VerifyReadyDlg (4). Path validation is done by the CheckTargetPath event itself; the
        old WIXUI_INSTALLDIR_VALID property is never set, so a guard on it is always false and the
        dialog would never show. A later NewDialog (Order 5) overrides the destination dialog and
        mirrors the stock one, so it only needs NOT Installed.
      -->
      <Publish Dialog="InstallDirDlg" Control="Next" Event="NewDialog" Value="SqlInstanceDlg"
               Order="5" Condition="NOT Installed" />
      <Publish Dialog="VerifyReadyDlg" Control="Back" Event="NewDialog" Value="SqlInstanceDlg"
               Order="3" Condition="NOT Installed" />

      <Dialog Id="SqlInstanceDlg" Width="370" Height="270" Title="!(loc.SqlInstanceDlg_Title)">
        <Control Id="BannerBitmap" Type="Bitmap" X="0" Y="0" Width="370" Height="44"
                 TabSkip="no" Text="WixUI_Bmp_Banner" />
        <Control Id="BannerLine" Type="Line" X="0" Y="44" Width="373" Height="0" />
        <Control Id="Title" Type="Text" X="15" Y="6" Width="200" Height="15"
                 Transparent="yes" NoPrefix="yes" Text="!(loc.SqlInstanceDlg_Heading)" />
        <Control Id="Description" Type="Text" X="25" Y="23" Width="335" Height="15"
                 Transparent="yes" NoPrefix="yes"
                 Text="!(loc.SqlInstanceDlg_Description)" />

        <!-- Exactly one of these three messages is visible. -->
        <Control Id="InstanceLabel" Type="Text" X="20" Y="52" Width="330" Height="40"
                 Transparent="yes" NoPrefix="yes"
                 Text="!(loc.SqlInstanceDlg_InstanceLabel)"
                 HideCondition="NOT SQLINSTANCEFOUND" />
        <Control Id="NoEngineMessage" Type="Text" X="20" Y="52" Width="330" Height="72"
                 Transparent="yes" NoPrefix="yes"
                 Text="!(loc.SqlInstanceDlg_NoEngine)"
                 HideCondition="NOT SQLENGINEMISSING" />
        <Control Id="NoListMessage" Type="Text" X="20" Y="52" Width="330" Height="40"
                 Transparent="yes" NoPrefix="yes"
                 Text="!(loc.SqlInstanceDlg_NoList)"
                 HideCondition="SQLINSTANCEFOUND OR SQLENGINEMISSING" />

        <!-- Editable combo (ComboList="no"): detected instances in the list, anything else can be typed. -->
        <Control Id="ManualLabel" Type="Text" X="20" Y="128" Width="330" Height="12"
                 Transparent="yes" NoPrefix="yes" Text="!(loc.SqlInstanceDlg_ManualLabel)" />
        <Control Id="InstanceCombo" Type="ComboBox" X="20" Y="143" Width="320" Height="16"
                 Property="SQLINSTANCE" ComboList="no" Sorted="no" />

        <Control Id="SkipDbCheck" Type="CheckBox" X="20" Y="168" Width="330" Height="30"
                 Property="SQLSKIPDB" CheckBoxValue="1" Text="!(loc.SqlInstanceDlg_SkipDb)" />

        <Control Id="Retry" Type="PushButton" X="20" Y="205" Width="110" Height="17"
                 Text="!(loc.SqlInstanceDlg_Retry)">
          <!-- Re-detect, then rebuild the dialog so the combo list is reloaded. -->
          <Publish Event="DoAction" Value="DetectSqlInstances" Order="1" />
          <Publish Event="NewDialog" Value="SqlInstanceDlg" Order="2" />
        </Control>

        <!-- Interim status while ValidateSqlInstance runs (worst case about 35 s). -->
        <Control Id="ValidationStatus" Type="Text" X="140" Y="205" Width="210" Height="24"
                 Transparent="yes" NoPrefix="yes" Text=" ">
          <Subscribe Event="ActionText" Attribute="Text" />
        </Control>

        <Control Id="BottomLine" Type="Line" X="0" Y="234" Width="373" Height="0" />
        <Control Id="Back" Type="PushButton" X="180" Y="243" Width="56" Height="17" Text="!(loc.SqlInstanceDlg_Back)">
          <Publish Event="NewDialog" Value="InstallDirDlg" />
        </Control>
        <Control Id="Next" Type="PushButton" X="236" Y="243" Width="56" Height="17"
                 Default="yes" Text="!(loc.SqlInstanceDlg_Next)">
          <!-- Validate (service state + connection); only advance if valid, otherwise explain why. -->
          <Publish Event="DoAction" Value="ValidateSqlInstance" Order="1" />
          <Publish Event="NewDialog" Value="VerifyReadyDlg" Order="2" Condition="SQLVALID = &quot;1&quot;" />
          <Publish Event="SpawnDialog" Value="SqlErrorDlg" Order="3" Condition="NOT (SQLVALID = &quot;1&quot;)" />
        </Control>
        <Control Id="Cancel" Type="PushButton" X="304" Y="243" Width="56" Height="17"
                 Cancel="yes" Text="!(loc.SqlInstanceDlg_Cancel)">
          <Publish Event="SpawnDialog" Value="CancelDlg" />
        </Control>
      </Dialog>

      <!-- Modal dialog that shows the readable reason (SQLERRORMSG) when validation fails. -->
      <Dialog Id="SqlErrorDlg" Width="300" Height="170" Title="!(loc.SqlErrorDlg_Title)">
        <Control Id="ErrTitle" Type="Text" X="15" Y="8" Width="270" Height="15"
                 Transparent="yes" NoPrefix="yes" Text="!(loc.SqlErrorDlg_Heading)" />
        <Control Id="ErrText" Type="Text" X="15" Y="26" Width="270" Height="110"
                 Transparent="yes" NoPrefix="yes" Text="[SQLERRORMSG]" />
        <Control Id="ErrOk" Type="PushButton" X="229" Y="146" Width="56" Height="17"
                 Default="yes" Cancel="yes" Text="!(loc.SqlErrorDlg_Ok)">
          <Publish Event="EndDialog" Value="Return" />
        </Control>
      </Dialog>
    </UI>

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="Club de Vinos">
        <Directory Id="DBSCRIPTDIR" Name="BaseDeDatos" />
      </Directory>
    </StandardDirectory>

    <Feature Id="Main" Title="Club de Vinos" Level="1" AllowAbsent="no">
      <ComponentGroupRef Id="AppFiles" />
      <ComponentRef Id="DbScriptFiles" />
      <ComponentRef Id="SqlInstanceSetting" />
    </Feature>

    <!-- Database creation + script. Disabled (Level 0) when the user chose "install only the application". -->
    <Feature Id="Database" Title="Base de datos" Level="1" AllowAbsent="no">
      <Level Value="0" Condition="SQLSKIPDB" />
      <ComponentRef Id="DatabaseComponent" />
    </Feature>
  </Package>

  <Fragment>
    <!-- Original script + helper .cmd: lets the user create the database later (mode "only the application"). -->
    <Component Id="DbScriptFiles" Directory="DBSCRIPTDIR" Bitness="always64"
               Guid="A41D7C20-6E3B-4F58-9C12-0B7E5D83A164">
      <File Id="DbScriptSql" Source="$(SqlScriptSource)" Name="script.sql" KeyPath="yes" />
      <File Id="DbScriptCmd" Source="$(ScriptCmdSource)" Name="EjecutarScript.cmd" />
    </Component>
  </Fragment>

  <Fragment>
    <!--
      Tells the app (DAL\Acceso.cs) which SQL Server instance to use. It lives in the Main feature on
      purpose: it is written even when the user chose "only the application", because the script will
      be run later against that same instance. 64-bit view, consistent with the x64 package; the app
      reads both views. Removed on uninstall; the database itself is never dropped.
    -->
    <Component Id="SqlInstanceSetting" Directory="INSTALLFOLDER" Bitness="always64"
               Guid="B7D2E5A9-4C18-4F63-A0E7-9D15C3F82B46">
      <RegistryValue Root="HKLM" Key="Software\Club de Vinos" Name="SqlInstance"
                     Type="string" Value="[SQLINSTANCE]" KeyPath="yes" />
    </Component>
  </Fragment>

  <Fragment>
    <ComponentGroup Id="AppFiles" Directory="INSTALLFOLDER">
      <Component Id="MainExecutable" Bitness="always64">
        <File Id="CapasExe" Source="$(AppBinDir)\CAPAS.exe" KeyPath="yes">
          <Shortcut Id="StartMenuShortcut" Directory="ProgramMenuFolder" Name="Club de Vinos"
                    WorkingDirectory="INSTALLFOLDER" Advertise="yes" Icon="AppIcon.ico" />
          <Shortcut Id="DesktopShortcut" Directory="DesktopFolder" Name="Club de Vinos"
                    WorkingDirectory="INSTALLFOLDER" Advertise="yes" Icon="AppIcon.ico" />
        </File>
      </Component>

      <!-- Everything else the app needs at runtime: config, DLLs and the 'de' satellite folder. -->
      <Files Include="$(AppBinDir)\**">
        <Exclude Files="$(AppBinDir)\CAPAS.exe" />
        <Exclude Files="$(AppBinDir)\**\*.pdb" />
        <Exclude Files="$(AppBinDir)\app.publish\**" />
        <Exclude Files="$(AppBinDir)\Remitos\**" />
      </Files>
    </ComponentGroup>
  </Fragment>

  <Fragment>
    <!--
      The database is created if missing and NEVER dropped on uninstall: the same BDCAPAS
      may hold real data. Windows authentication (no User element). The server is the instance
      picked in SqlInstanceDlg ("." or ".\NAME"); with Instance left empty it is used as-is.
    -->
    <Component Id="DatabaseComponent" Directory="INSTALLFOLDER" Bitness="always64"
               Guid="3E8B6D14-52A7-4C90-B1F8-6D2A9E407C55">
      <RegistryValue Root="HKLM" Key="Software\Club de Vinos" Name="DatabaseInstalled"
                     Type="integer" Value="1" KeyPath="yes" />
      <sql:SqlDatabase Id="CapasDatabase" Server="[SQLINSTANCE]" Database="BDCAPAS"
                       CreateOnInstall="yes" DropOnInstall="no"
                       DropOnUninstall="no" CreateOnUninstall="no" />
      <sql:SqlScript Id="CapasSchemaScript" SqlDb="CapasDatabase" BinaryRef="CapasSchemaBinary"
                     ExecuteOnInstall="yes" ContinueOnError="no" />
    </Component>

    <!-- UTF-16 LE copy generated at build time by Instalador.wixproj. -->
    <Binary Id="CapasSchemaBinary" SourceFile="$(SqlScriptUtf16)" />
  </Fragment>
</Wix>
