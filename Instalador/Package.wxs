<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui"
     xmlns:sql="http://wixtoolset.org/schemas/v4/wxs/sql">

  <Package Name="Club de Vinos"
           Manufacturer="Club de Vinos"
           Version="1.3.1.0"
           UpgradeCode="7C1F3A52-9B0E-4D6A-8E21-5A4D0C9B7E13"
           Language="3082"
           Codepage="1252"
           Scope="perMachine"
           Compressed="yes">

    <MajorUpgrade DowngradeErrorMessage="!(loc.DowngradeError)" />
    <MediaTemplate EmbedCab="yes" />

    <!-- Icon for the shortcuts and the "Apps & features" entry. -->
    <Icon Id="AppIcon.ico" SourceFile="..\CAPAS\Resources\ClubDeVinos.ico" />
    <Property Id="ARPPRODUCTICON" Value="AppIcon.ico" />

    <!-- Dialog set with install directory selection. The license page is skipped (see UI below). -->
    <Property Id="WIXUI_INSTALLDIR" Value="INSTALLFOLDER" />

    <!-- SQL Server instance chosen in SqlInstanceDlg ("." = default local instance, ".\NAME" = named instance). -->
    <Property Id="SQLINSTANCE" Value="." Secure="yes" />

    <!-- The ComboBox table is not part of WixUI_InstallDir; the custom action inserts temporary rows into it. -->
    <EnsureTable Id="ComboBox" />

    <!-- Managed (DTF) custom action: reads the local instance names from the registry. -->
    <Binary Id="CustomActionsDll" SourceFile="$(var.CustomActions.TargetDir)CustomActions.CA.dll" />
    <CustomAction Id="DetectSqlInstances" BinaryRef="CustomActionsDll"
                  DllEntry="DetectSqlInstances" Execute="immediate" Return="check" />

    <!-- Runs before the dialogs are shown (WelcomeDlg is scheduled after MigrateFeatureStates). -->
    <InstallUISequence>
      <Custom Action="DetectSqlInstances" Before="CostInitialize" Condition="NOT Installed" />
    </InstallUISequence>

    <UI>
      <ui:WixUI Id="WixUI_InstallDir" />
      <Publish Dialog="WelcomeDlg" Control="Next" Event="NewDialog" Value="InstallDirDlg"
               Order="2" Condition="NOT Installed" />
      <Publish Dialog="InstallDirDlg" Control="Back" Event="NewDialog" Value="WelcomeDlg"
               Order="2" />

      <!--
        SqlInstanceDlg goes between InstallDirDlg and VerifyReadyDlg. WixUI_InstallDir publishes, on
        InstallDirDlg.Next: SetTargetPath (1), path validation (2), SpawnDialog InvalidDirDlg (3) and
        NewDialog VerifyReadyDlg (4), the last one guarded by a valid-path condition. A later NewDialog
        (Order 5) overrides the destination dialog, so it must repeat that guard; otherwise an invalid
        path would still advance after InvalidDirDlg is dismissed.
      -->
      <Publish Dialog="InstallDirDlg" Control="Next" Event="NewDialog" Value="SqlInstanceDlg"
               Order="5" Condition="NOT Installed AND (WIXUI_DONTVALIDATEPATH OR WIXUI_INSTALLDIR_VALID=&quot;1&quot;)" />
      <Publish Dialog="VerifyReadyDlg" Control="Back" Event="NewDialog" Value="SqlInstanceDlg"
               Order="3" Condition="NOT Installed" />

      <Dialog Id="SqlInstanceDlg" Width="370" Height="270" Title="!(loc.SqlInstanceDlg_Title)">
        <Control Id="BannerBitmap" Type="Bitmap" X="0" Y="0" Width="370" Height="44"
                 TabSkip="no" Text="WixUI_Bmp_Banner" />
        <Control Id="BannerLine" Type="Line" X="0" Y="44" Width="373" Height="0" />
        <Control Id="Title" Type="Text" X="15" Y="6" Width="200" Height="15"
                 Transparent="yes" NoPrefix="yes" Text="!(loc.SqlInstanceDlg_Heading)" />
        <Control Id="Description" Type="Text" X="25" Y="23" Width="335" Height="15"
                 Transparent="yes" NoPrefix="yes"
                 Text="!(loc.SqlInstanceDlg_Description)" />

        <!-- Shown when at least one instance was detected. -->
        <Control Id="InstanceLabel" Type="Text" X="20" Y="60" Width="330" Height="30"
                 Transparent="yes" NoPrefix="yes"
                 Text="!(loc.SqlInstanceDlg_InstanceLabel)"
                 HideCondition="NOT SQLINSTANCEFOUND" />
        <Control Id="InstanceCombo" Type="ComboBox" X="20" Y="95" Width="320" Height="16"
                 Property="SQLINSTANCE" ComboList="yes" Sorted="no"
                 HideCondition="NOT SQLINSTANCEFOUND" />

        <!-- Shown when no instance was found: the only options are Back or Cancel. -->
        <Control Id="NoInstanceMessage" Type="Text" X="20" Y="60" Width="330" Height="60"
                 Transparent="yes" NoPrefix="yes"
                 Text="!(loc.SqlInstanceDlg_NoInstance)"
                 HideCondition="SQLINSTANCEFOUND" />

        <Control Id="BottomLine" Type="Line" X="0" Y="234" Width="373" Height="0" />
        <Control Id="Back" Type="PushButton" X="180" Y="243" Width="56" Height="17" Text="!(loc.SqlInstanceDlg_Back)">
          <Publish Event="NewDialog" Value="InstallDirDlg" />
        </Control>
        <Control Id="Next" Type="PushButton" X="236" Y="243" Width="56" Height="17"
                 Default="yes" Text="!(loc.SqlInstanceDlg_Next)" DisableCondition="NOT SQLINSTANCEFOUND">
          <Publish Event="NewDialog" Value="VerifyReadyDlg" />
        </Control>
        <Control Id="Cancel" Type="PushButton" X="304" Y="243" Width="56" Height="17"
                 Cancel="yes" Text="!(loc.SqlInstanceDlg_Cancel)">
          <Publish Event="SpawnDialog" Value="CancelDlg" />
        </Control>
      </Dialog>
    </UI>

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="Club de Vinos" />
    </StandardDirectory>

    <Feature Id="Main" Title="Club de Vinos" Level="1" AllowAbsent="no">
      <ComponentGroupRef Id="AppFiles" />
      <ComponentRef Id="DatabaseComponent" />
    </Feature>
  </Package>

  <Fragment>
    <ComponentGroup Id="AppFiles" Directory="INSTALLFOLDER">
      <Component Id="MainExecutable" Bitness="always64">
        <File Id="CapasExe" Source="$(AppBinDir)\CAPAS.exe" KeyPath="yes">
          <Shortcut Id="StartMenuShortcut" Directory="ProgramMenuFolder" Name="Club de Vinos"
                    WorkingDirectory="INSTALLFOLDER" Advertise="yes" Icon="AppIcon.ico" />
          <Shortcut Id="DesktopShortcut" Directory="DesktopFolder" Name="Club de Vinos"
                    WorkingDirectory="INSTALLFOLDER" Advertise="yes" Icon="AppIcon.ico" />
        </File>
      </Component>

      <!-- Everything else the app needs at runtime: config, DLLs and the 'de' satellite folder. -->
      <Files Include="$(AppBinDir)\**">
        <Exclude Files="$(AppBinDir)\CAPAS.exe" />
        <Exclude Files="$(AppBinDir)\**\*.pdb" />
        <Exclude Files="$(AppBinDir)\app.publish\**" />
        <Exclude Files="$(AppBinDir)\Remitos\**" />
      </Files>
    </ComponentGroup>
  </Fragment>

  <Fragment>
    <!--
      The database is created if missing and NEVER dropped on uninstall: the same BDCAPAS
      may hold real data. Windows authentication (no User element). The server is the instance
      picked in SqlInstanceDlg ("." or ".\NAME"); with Instance left empty it is used as-is.
    -->
    <Component Id="DatabaseComponent" Directory="INSTALLFOLDER" Bitness="always64"
               Guid="3E8B6D14-52A7-4C90-B1F8-6D2A9E407C55">
      <RegistryValue Root="HKLM" Key="Software\Club de Vinos" Name="DatabaseInstalled"
                     Type="integer" Value="1" KeyPath="yes" />
      <sql:SqlDatabase Id="CapasDatabase" Server="[SQLINSTANCE]" Database="BDCAPAS"
                       CreateOnInstall="yes" DropOnInstall="no"
                       DropOnUninstall="no" CreateOnUninstall="no" />
      <sql:SqlScript Id="CapasSchemaScript" SqlDb="CapasDatabase" BinaryRef="CapasSchemaBinary"
                     ExecuteOnInstall="yes" ContinueOnError="no" />
    </Component>

    <!-- UTF-16 LE copy generated at build time by Instalador.wixproj. -->
    <Binary Id="CapasSchemaBinary" SourceFile="$(SqlScriptUtf16)" />
  </Fragment>
</Wix>
