<?xml version="1.0" encoding="utf-8"?>
<!--
  Indica al host SfxCA de DTF qué CLR cargar. Sin este archivo intenta el CLR 2.0
  (.NET 3.5), que no está instalado por defecto en Windows 10/11, y la acción
  falla con 0x80131700 antes de ejecutarse.
-->
<configuration>
  <startup useLegacyV2RuntimeActivationPolicy="true">
    <supportedRuntime version="v4.0" />
  </startup>
</configuration>
