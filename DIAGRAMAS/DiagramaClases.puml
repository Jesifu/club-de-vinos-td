  ' ── Dominio: catálogo y stock de vinos (gestion-catalogo-stock-vinos) ──
  enum EstadoVino {
    Activo
    Descontinuado
    Pendiente
    Rechazado
  }

  enum TipoSolicitud {
    Alta
    Baja
  }

  enum EstadoSolicitud {
    Pendiente
    Aprobada
    Rechazada
  }

  enum TipoMovimiento {
    Entrada
    Salida
  }

  class Vino {
    + Id : int
    + Codigo : string
    + Nombre : string
    + BodegaId : int
    + BodegaNombre : string
    + Varietal : string
    + Aniada : int
    + Precio : decimal
    + StockMinimo : int
    + Estado : EstadoVino
    + Maridaje : string
    + Puntaje : int?
    + CreadoPor : int
    + CreadoPorLogin : string
    + FechaAlta : DateTime
    + UltimaSolicitudTipo : TipoSolicitud?
    + UltimaSolicitudEstado : EstadoSolicitud?
    + UltimoMotivoRechazo : string
  }

  class SolicitudAutorizacion {
    + Id : int
    + Tipo : TipoSolicitud
    + VinoId : int
    + VinoCodigo : string
    + VinoNombre : string
    + BodegaNombre : string
    + Estado : EstadoSolicitud
    + EmisorId : int
    + EmisorLogin : string
    + FechaEmision : DateTime
    + ResolutorId : int?
    + ResolutorLogin : string
    + FechaResolucion : DateTime?
    + MotivoRechazo : string
    + StockActual : int
    + Vino : Vino
  }

  class Bodega {
    + Id : int
    + Nombre : string
    + Pais : string
    + Region : string
    + Habilitado : bool
    + ToString() : string
  }

  class MovimientoStock {
    + Id : int
    + VinoId : int
    + VinoNombre : string
    + Fecha : DateTime
    + Tipo : TipoMovimiento
    + Cantidad : int
    + Motivo : string
    + Responsable : string
    + ReferenciaTipo : string
    + ReferenciaId : int?
  }

  class AlertaStockMinimo {
    + VinoId : int
    + Codigo : string
    + Nombre : string
    + BodegaNombre : string
    + StockMinimo : int
    + StockActual : int
    + Faltante : int
  }

  Vino --> EstadoVino
  Vino --> TipoSolicitud
  Vino --> EstadoSolicitud
  Vino --> Bodega : BodegaId >
  SolicitudAutorizacion "0..*" --> "1" Vino : Vino >
  SolicitudAutorizacion --> TipoSolicitud
  SolicitudAutorizacion --> EstadoSolicitud
  MovimientoStock --> TipoMovimiento
  MovimientoStock --> Vino : VinoId >

  ' ── Dominio: curación y armado de cajas mensuales (curacion-cajas-mensuales) ──
  enum EstadoCaja {
    Armada
    Despachada
    Cancelada
  }

  class Socio {
    + Id : int
    + Nombre : string
    + Apellido : string
    + Email : string
    + Telefono : string
    + Domicilio : string
    + PresupuestoMensual : decimal
    + Activo : bool
    + FechaAlta : DateTime
    + CreadoPor : int
    + CreadoPorLogin : string
    + VarietalesPreferidos : List<string>
    + ToString() : string
  }

  class CajaMensual {
    + Id : int
    + SocioId : int
    + SocioNombre : string
    + SocioDomicilio : string
    + SocioTelefono : string
    + Periodo : string
    + Estado : EstadoCaja
    + PresupuestoSnapshot : decimal
    + FechaArmado : DateTime
    + ArmadoPor : int
    + ArmadoPorLogin : string
    + FechaDespacho : DateTime?
    + DespachadoPor : int?
    + DespachadoPorLogin : string
    + FechaCancelacion : DateTime?
    + CanceladaPor : int?
    + MotivoCancelacion : string
    + Lineas : List<CajaVino>
  }

  class CajaVino {
    + Id : int
    + CajaId : int
    + VinoId : int
    + Cantidad : int
    + NombreSnapshot : string
    + PrecioSnapshot : decimal
    + VinoEfectivoId : int
    + NombreEfectivo : string
    + PrecioEfectivo : decimal
    + Sustituido : bool
    + StockDisponible : int
  }

  class Sustitucion {
    + Id : int
    + CajaVinoId : int
    + VinoOriginalId : int
    + VinoReemplazoId : int
    + NombreSnapshot : string
    + PrecioSnapshot : decimal
    + Motivo : string
    + ResponsableId : int
    + ResponsableLogin : string
    + Fecha : DateTime
  }

  class VinoCandidato {
    + Id : int
    + Codigo : string
    + Nombre : string
    + BodegaNombre : string
    + Varietal : string
    + Aniada : int
    + Precio : decimal
    + Stock : int
    + Preferido : bool
    + ToString() : string
  }

  CajaMensual  "0..*" --> "1" Socio : SocioId >
  CajaMensual  "1" o-- "0..*" CajaVino : Lineas
  Sustitucion  "0..*" --> "1" CajaVino : CajaVinoId >
  CajaMensual  --> EstadoCaja

  abstract class NodoPermiso {
    + Id : int
    + Nombre : string
    + PadreId : int?
    + DVH : int
    + {abstract} Agregar(nodo : NodoPermiso) : void
    + {abstract} Quitar(nodo : NodoPermiso) : void
    + {abstract} ObtenerHijos() : IList<NodoPermiso>
    + {abstract} EsHoja() : bool
    + ToString() : string
  }

  class Rol {
    + Protegido : bool
    - _hijos : List<NodoPermiso>
    + Agregar(nodo : NodoPermiso) : void
    + Quitar(nodo : NodoPermiso) : void
    + ObtenerHijos() : IList<NodoPermiso>
    + EsHoja() : bool
  }

  class Permiso {
    + Agregar(nodo : NodoPermiso) : void
    + Quitar(nodo : NodoPermiso) : void
    + ObtenerHijos() : IList<NodoPermiso>
    + EsHoja() : bool
  }

  NodoPermiso <|-- Rol
  NodoPermiso <|-- Permiso
  Rol "1" o-- "0..*" NodoPermiso : _hijos
}

' ─────────────────────────────────────────
' CAPA SeguridadYServicios
' ─────────────────────────────────────────
package "SeguridadYServicios" #D5E8D4 {

  interface IObservadorIdioma {
    + ActualizarIdioma() : void
  }

  class Hasher <<static>> {
    + {static} Hashear(texto : string) : string
  }

  class ValidadorContrasena <<static>> {
    + {static} LargoMinimo : int = 6
    + {static} ObtenerError(contrasena : string) : string
  }

  class CalculadorDVH <<static>> {
    + {static} Calcular(atributos : string[]) : int
    + {static} CalcularVertical(filas : List<string[]>, colIdx : int) : int
  }

  class SessionManager <<singleton>> {
    - {static} _instance : SessionManager
    - {static} _cerrojo : object
    - _usuario : USUARIO
    - _permisos : List<string>
    + {static} getInstance() : SessionManager
    + getUsuario() : USUARIO
    + setUsuario(usuario : USUARIO) : void
    + setPermisos(permisos : List<string>) : void
    + TienePermiso(nombrePermiso : string) : bool
    + cerrarSesion() : void
    + EsAdmin() : bool
  }

  class IdiomaManager <<singleton>> {
    - {static} _instance : IdiomaManager
    - {static} _cerrojo : object
    - _observers : List<IObservadorIdioma>
    - _traducciones : Dictionary<string, string>
    - _idiomaActivo : IDIOMA
    + {static} getInstance() : IdiomaManager
    + IdiomaActivo : IDIOMA
    + Registrar(obs : IObservadorIdioma) : void
    + Desregistrar(obs : IObservadorIdioma) : void
    + CambiarIdioma(idioma : IDIOMA, traducciones : Dictionary<string, string>) : void
    - Notificar() : void
    + Traducir(clave : string) : string
  }

  IdiomaManager "1" o-- "0..*" IObservadorIdioma : _observers
  IdiomaManager --> IDIOMA : IdiomaActivo >
  SessionManager --> USUARIO : usa >
}

