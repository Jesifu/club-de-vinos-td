@startuml DiagramaSecuencia_CU05_CambiarIdioma

title CU-05 — Cambiar Idioma — Diagrama de Secuencia

skinparam shadowing false
skinparam roundcorner 6
skinparam sequenceArrowThickness 1.2
skinparam sequenceMessageAlign center
hide footbox
scale 0.8

' ─────────────────────────────────────────
' Participantes en orden de aparición
' ─────────────────────────────────────────
actor       ":Usuario"                 as U
participant ":FormularioActual"        as F  #FEFECE
participant ":OtroFormulario\nAbierto" as F2 #FEFECE
participant ":IdiomaBLL"               as IB #E8F4E8
participant ":UsuarioBLL"              as UB #E8F4E8
participant ":IdiomaManager"           as IM #F4E8E8
participant ":SessionManager"          as SM #F4E8E8
participant ":IdiomaDAL"               as IDD #E8E8F4
participant ":UsuarioDAL"              as UD #E8E8F4
database    ":DB"                      as DB #EEEEEE

note over F
  Precondición: usuario autenticado.
  El combo de idiomas fue agregado por
  IdiomaUIHelper.AgregarSelector() al
  cargar el formulario, listando solo
  idiomas habilitados (RN-01).
end note

== 1. Selección de idioma ==

U -> F : desplegar combo de idiomas\n+ seleccionar un idioma

opt 2a. el idioma seleccionado es el mismo que el activo
  note right of F
    El ComboBox no dispara
    SelectedIndexChanged
    (no hay cambio de índice).
    El caso de uso termina aquí.
  end note
end

== 2. Carga de traducciones ==

opt el selector es el de frmMenu
  loop por cada ítem de menú
    F -> IB : RegistrarControl(clave, "[" + textoDefault + "]")
    IB -> IDD : RegistrarControl(clave, textoDefault)
    IDD -> DB : CONTROL_REGISTRAR(@clave, @texto_default)
  end
end

F -> IB : CargarTraducciones(idioma.Id)
activate IB
IB -> IDD : CargarTraducciones(idiomaId)
IDD -> IDD : ListarControlesConTraduccion(idiomaId)
IDD -> DB : TRADUCCION_LISTAR_CONTROLES(@idioma_id)
DB --> IDD : filas (CLAVE, TEXTO_DEFAULT, TEXTO_TRADUCCION)
IDD --> IB : Dictionary<clave, texto>
IB --> F : Dictionary<clave, texto>
deactivate IB

== 3. Actualización del idioma activo ==

F -> IM : CambiarIdioma(idioma, traducciones)
activate IM
IM -> IM : _idiomaActivo = idioma\n_traducciones = traducciones

== 4. Notificación a los formularios registrados ==

loop por cada formulario registrado (incluye F)
  IM -> F2 : ActualizarIdioma()
  activate F2

  loop por cada control en _controles
    F2 -> IM : Traducir(clave)
    IM --> F2 : texto / null
    F2 -> F2 : control.Text = texto\n?? _defaults[clave]\n(RN-03)
  end

  opt el formulario tiene DataGridView
    F2 -> F2 : ActualizarEncabezados()
  end

  F2 --> IM : (formulario actualizado)
  deactivate F2
end
IM --> F : (observadores notificados)
deactivate IM

== 5. Persistencia de la preferencia del usuario ==

F -> SM : getUsuario()
SM --> F : usuario / null

opt hay un usuario logueado
  F -> UB : ActualizarIdioma(usuario.Id, idioma.Id)
  activate UB
  UB -> UD : ActualizarIdioma(id, idiomaId)
  UD -> DB : USUARIO_ACTUALIZAR_IDIOMA(@id, @idioma_id)
  deactivate UB

  note right of F
    RN-04: el selector de idioma del
    formulario de login (pre-autenticación)
    no persiste la preferencia porque
    todavía no hay sesión activa
    (SessionManager sin usuario).
  end note
end

@enduml
