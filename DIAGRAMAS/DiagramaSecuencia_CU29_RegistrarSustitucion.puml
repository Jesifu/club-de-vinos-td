@startuml DiagramaSecuencia_CU29_RegistrarSustitucion

title CU-29 — Registrar Sustitución por Falta de Stock — Diagrama de Secuencia

skinparam shadowing false
skinparam roundcorner 6
skinparam sequenceArrowThickness 1.2
skinparam sequenceMessageAlign center
hide footbox
scale 0.75

actor       ":Usuario"           as U
participant ":frmPickingCaja"    as FP #FEFECE
participant ":CajaMensualBLL"    as CB #E8F4E8
participant ":BitacoraBLL"       as BB #E8F4E8
participant ":CajaMensualDAL"    as CD #E8E8F4
participant ":VinoDAL"           as VD #E8E8F4
participant ":SustitucionDAL"    as SD #E8E8F4
participant ":BitacoraDAL"       as BD #E8E8F4
database    ":DB"                as DB #EEEEEE

note over FP
  Precondición: permiso "Registrar picking y sustituciones";
  la caja está en estado Armada; RN-10 — quien armó la caja
  no puede registrar sus sustituciones.
end note

U -> FP : abrir picking
activate FP
FP -> CB : ListarArmadas()
activate CB
CB -> CD : ListarPorEstado("Armada")
activate CD
CD -> DB : CAJA_LISTAR_POR_ESTADO(@estado)
DB --> CD : filas
CD --> CB : List<CajaMensual>
deactivate CD
CB --> FP : List<CajaMensual>
deactivate CB

U -> FP : seleccionar una caja armada

FP -> CB : ObtenerConComposicionEfectiva(cajaFila.Id)
activate CB
CB -> CD : ObtenerPorId(cajaId)
activate CD
CD -> DB : CAJA_OBTENER_POR_ID(@id)
DB --> CD : fila
CD --> CB : CajaMensual
CB -> CD : ListarComposicionEfectiva(cajaId)
CD -> DB : CAJA_VINO_LISTAR_EFECTIVO(@caja_id)
DB --> CD : composición efectiva + stock disponible por línea
CD --> CB : List<CajaVino>
deactivate CD
note right of CD
  RN-07 — la composición efectiva se DERIVA
  de CAJA_VINO ⟕ SUSTITUCION en la SP; nunca se edita la línea.
end note
CB -> CB : caja.Lineas = composición efectiva
CB --> FP : CajaMensual
deactivate CB

FP -> CB : ListarCandidatos(caja.SocioId)
activate CB
CB -> VD : ListarCandidatos(socioId)
activate VD
VD -> DB : VINO_LISTAR_CANDIDATOS(@socio_id)
DB --> VD : filas
VD --> CB : List<VinoCandidato>
deactivate VD
CB --> FP : List<VinoCandidato>
deactivate CB

FP -> CB : ListarTrazaSustituciones(caja.Id)
activate CB
CB -> SD : ListarPorCaja(cajaId)
activate SD
SD -> DB : SUSTITUCION_LISTAR_POR_CAJA(@caja_id)
DB --> SD : filas
SD --> CB : List<Sustitucion>
deactivate SD
CB --> FP : List<Sustitucion>
deactivate CB

FP -> FP : marcar líneas con faltante (StockDisponible < Cantidad);\nbtnRegistrarSustitucion.Enabled = caja.ArmadoPor != sesion.Id
note right of FP : capa UI del triple guard de RN-10.

U -> FP : seleccionar línea con faltante + vino de reemplazo + motivo
U -> FP : click "Registrar sustitución"
FP -> CB : RegistrarSustitucion(caja.Id, linea.Id, reemplazo.Id, motivo, sesion)
activate CB
CB -> CD : ObtenerPorId(cajaId)
activate CD
CD -> DB : CAJA_OBTENER_POR_ID(@id)
DB --> CD : fila
CD --> CB : CajaMensual
deactivate CD

alt la caja no existe
  CB --> FP : InvalidOperationException
  FP --> U : mensaje de la excepción
else 8a. el usuario armó esta caja (RN-10)
  CB --> FP : InvalidOperationException
  FP --> U : mensaje de la excepción
else 8b. la caja no está en estado Armada (RN-08)
  CB --> FP : InvalidOperationException
  FP --> U : mensaje de la excepción
else la caja es sustituible
  CB -> CD : ListarComposicionEfectiva(cajaId)
  activate CD
  CD -> DB : CAJA_VINO_LISTAR_EFECTIVO(@caja_id)
  DB --> CD : filas
  CD --> CB : List<CajaVino>
  deactivate CD
  CB -> VD : ListarCandidatos(caja.SocioId)
  activate VD
  VD -> DB : VINO_LISTAR_CANDIDATOS(@socio_id)
  DB --> VD : filas
  VD --> CB : List<VinoCandidato>
  deactivate VD
  CB -> CB : ubicar la línea y el reemplazo; recalcular el total efectivo con el reemplazo

  alt la línea no pertenece a la caja
    CB --> FP : InvalidOperationException
    FP --> U : mensaje de la excepción
  else 8c. el reemplazo no está entre los candidatos vigentes (RN-06)
    CB --> FP : InvalidOperationException
    FP --> U : mensaje de la excepción
  else 8c. el total con el reemplazo supera el PresupuestoSnapshot (RN-05)
    CB --> FP : InvalidOperationException
    FP --> U : mensaje de la excepción
  else sustitución válida
    CB -> SD : Insertar(sustitucion)
    activate SD
    SD -> DB : SUSTITUCION_INSERTAR(@caja_vino_id,@vino_original_id,@vino_reemplazo_id,\n@nombre_snapshot,@precio_snapshot,@motivo,@responsable_id)
    note right of DB
      backstop en el WHERE:
      ESTADO = 'Armada' AND ARMADO_POR <> @responsable_id
    end note
    DB --> SD : filas afectadas
    SD --> CB : int filas
    deactivate SD

    alt filas == 0 (la caja cambió de estado)
      CB --> FP : InvalidOperationException
      FP --> U : mensaje de la excepción
    else filas > 0
      CB -> BB : RegistrarAccion(sesion.Usuario, "SUSTITUCION_CAJA:" + cajaId)
      activate BB
      BB -> BD : Registrar(usuario, accion)
      activate BD
      BD -> DB : BITACORA_INSERTAR(@usuario,@accion)
      deactivate BD
      BB --> CB
      deactivate BB
      CB --> FP : void
      FP --> U : "Sustitución registrada correctamente."
      FP -> CB : ObtenerConComposicionEfectiva(caja.Id)
      CB --> FP : CajaMensual con el vino de reemplazo en la grilla
      note right of FP : CargarComposicion() también vuelve a pedir\ncandidatos y traza de sustituciones.
    end
  end
end
deactivate CB
deactivate FP

@enduml
