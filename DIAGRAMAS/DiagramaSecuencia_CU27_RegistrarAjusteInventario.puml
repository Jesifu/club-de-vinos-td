@startuml DiagramaSecuencia_CU27_RegistrarAjusteInventario

title CU-27 — Registrar Ajuste de Inventario — Diagrama de Secuencia

skinparam shadowing false
skinparam roundcorner 6
skinparam sequenceArrowThickness 1.2
skinparam sequenceMessageAlign center
hide footbox
scale 0.8

actor       ":Usuario"            as U
participant ":frmMovimientoStock" as FM #FEFECE
participant ":StockBLL"           as SB #E8F4E8
participant ":StockDAL"           as SD #E8E8F4
database    ":DB"                 as DB #EEEEEE

note over FM
  Precondición: sesión activa,
  permiso "Gestionar catálogo de vinos".
end note

U -> FM : abrir "Registrar ajuste de inventario" + seleccionar vino
activate FM
FM -> SB : ObtenerStockActual(vinoId)
SB -> SD : ObtenerStockActual(vinoId)
activate SD
SD -> DB : STOCK_ACTUAL(vinoId)\n(SUM(Entrada) - SUM(Salida))
DB --> SD : cantidad actual
SD --> SB : int
deactivate SD
SB --> FM : int
FM -> FM : mostrar stock actual

U -> FM : indicar sentido (positivo/negativo),\ncantidad y motivo (rotura, merma,\ncorrección de conteo) + click Registrar
alt sentido negativo
  FM -> SB : RegistrarSalida(movimiento)
  activate SB
  SB -> SD : ObtenerStockActual(vinoId)
  activate SD
  SD -> DB : STOCK_ACTUAL(vinoId)
  DB --> SD : cantidad actual
  SD --> SB : int
  deactivate SD

  alt 2a. stock resultante menor a cero (RN-03)
    SB --> FM : InvalidOperationException("Stock insuficiente")
    deactivate SB
    FM --> U : "No hay stock suficiente para este ajuste."
    note right of FM : el flujo vuelve al paso 2,\nno se registra el movimiento
  else stock suficiente
    SB -> SD : Insertar(movimiento)
    activate SD
    SD -> DB : MOVIMIENTO_STOCK_INSERTAR(vinoId, "Salida",\ncantidad, motivo, responsable)
    DB --> SD : OK
    SD --> SB : void
    deactivate SD
    SB --> FM : true
    deactivate SB
    FM --> U : "Ajuste registrado. Stock actualizado."
  end
else sentido positivo
  FM -> SB : RegistrarEntrada(movimiento)
  activate SB
  SB -> SD : Insertar(movimiento)
  activate SD
  SD -> DB : MOVIMIENTO_STOCK_INSERTAR(vinoId, "Entrada",\ncantidad, motivo, responsable)
  DB --> SD : OK
  SD --> SB : void
  deactivate SD
  SB --> FM : true
  deactivate SB
  FM --> U : "Ajuste registrado. Stock actualizado."
end

FM -> SB : ObtenerStockActual(vinoId)
SB -> SD : ObtenerStockActual(vinoId)
activate SD
SD -> DB : STOCK_ACTUAL(vinoId)
DB --> SD : nueva cantidad
SD --> SB : int
deactivate SD
SB --> FM : int
FM -> FM : refrescar stock actual en pantalla
deactivate FM

@enduml
