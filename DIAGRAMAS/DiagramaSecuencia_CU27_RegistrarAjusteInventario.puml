@startuml DiagramaSecuencia_CU27_RegistrarAjusteInventario

title CU-27 — Registrar Ajuste de Inventario — Diagrama de Secuencia

skinparam shadowing false
skinparam roundcorner 6
skinparam sequenceArrowThickness 1.2
skinparam sequenceMessageAlign center
hide footbox
scale 0.65

actor       ":Usuario"                       as U
participant ":frmRegistrarAjusteInventario"  as FJ #FEFECE
participant ":VinoBLL"                       as VB #E8F4E8
participant ":MovimientoStockBLL"            as MB #E8F4E8
participant ":BitacoraBLL"                   as BB #E8F4E8
participant ":VinoDAL"                       as VD #E8E8F4
participant ":MovimientoStockDAL"            as MD #E8E8F4
participant ":BitacoraDAL"                   as TD #E8E8F4
database    ":DB"                            as DB #EEEEEE

note over FJ
  Precondición: sesión activa; permiso "Gestionar catálogo de vinos";
  existe al menos un vino autorizado y activo.
end note

U -> FJ : abrir "Registrar ajuste de inventario"
activate FJ
FJ -> VB : ListarAutorizados()
activate VB
VB -> VD : ListarAutorizados()
activate VD
VD -> DB : VINO_LISTAR_AUTORIZADOS
DB --> VD : filas
VD --> VB : List<Vino>
deactivate VD
VB --> FJ : List<Vino>
deactivate VB

FJ -> MB : ObtenerStockActual(vino.Id)
activate MB
MB -> MD : ObtenerStockActual(vinoId)
activate MD
MD -> DB : STOCK_ACTUAL_OBTENER(@vino_id)
DB --> MD : STOCK
MD --> MB : int
deactivate MD
MB --> FJ : int
deactivate MB
FJ -> MB : ObtenerMovimientos(vino.Id)
activate MB
MB -> MD : ListarPorVino(vinoId)
activate MD
MD -> DB : MOVIMIENTO_STOCK_LISTAR_POR_VINO(@vino_id)
DB --> MD : filas
MD --> MB : List<MovimientoStock>
deactivate MD
MB --> FJ : List<MovimientoStock>
deactivate MB
FJ -> FJ : mostrar stock actual y movimientos del vino

U -> FJ : seleccionar vino, sentido (positivo / negativo),\ncantidad y motivo + click "Registrar ajuste"

alt sentido negativo
  FJ -> MB : RegistrarSalida(movimiento, sesion)
  activate MB

  alt 2a. cantidad <= 0 o motivo vacío
    MB --> FJ : InvalidOperationException
    FJ --> U : mensaje de la excepción
  else datos válidos
    MB -> VD : ObtenerPorId(movimiento.VinoId)
    activate VD
    VD -> DB : VINO_OBTENER_POR_ID(@id)
    DB --> VD : filas
    VD --> MB : Vino (o null)
    deactivate VD

    alt 2b. el vino no existe, no está autorizado o no está activo
      MB --> FJ : InvalidOperationException
      FJ --> U : mensaje de la excepción
    else vino autorizado y activo
      MB -> MD : ObtenerStockActual(vinoId)
      activate MD
      MD -> DB : STOCK_ACTUAL_OBTENER(@vino_id)
      DB --> MD : STOCK
      MD --> MB : int
      deactivate MD

      alt 2c. stock actual menor a la cantidad a descontar (RN-03, capa BLL)
        MB --> FJ : InvalidOperationException
        FJ --> U : mensaje de la excepción
      else stock suficiente
        note right of MB : Tipo = Salida; Fecha = ahora; Responsable = sesion.Usuario;\nReferenciaTipo = "AJUSTE"; ReferenciaId = null
        MB -> MD : InsertarSalida(movimiento)
        activate MD
        MD -> DB : MOVIMIENTO_STOCK_REGISTRAR_SALIDA(@vino_id,@cantidad,\n@motivo,@responsable,@referencia_tipo,@referencia_id)
        DB --> MD : filas afectadas
        MD --> MB : int
        deactivate MD

        alt 2d. 0 filas afectadas (RN-03, backstop atómico de la SP)
          MB --> FJ : InvalidOperationException
          FJ --> U : mensaje de la excepción
        else 1 fila afectada
          MB -> BB : RegistrarAccion(sesion.Usuario,\n"AJUSTE_STOCK:" + vino.Codigo + ":-" + cantidad)
          activate BB
          BB -> TD : Registrar(usuario, accion)
          activate TD
          TD -> DB : BITACORA_INSERTAR(@usuario,@accion)
          DB --> TD : filas afectadas
          TD --> BB : void
          deactivate TD
          BB --> MB : void
          deactivate BB
          MB --> FJ : void
          FJ --> U : "Ajuste de inventario registrado correctamente."
        end
      end
    end
  end
  deactivate MB
else sentido positivo
  note right of FJ : movimiento.ReferenciaTipo = "AJUSTE"\n(MovimientoStockBLL.ReferenciaAjuste)
  FJ -> MB : RegistrarEntrada(movimiento, sesion)
  activate MB

  alt 3a. cantidad <= 0 o motivo vacío
    MB --> FJ : InvalidOperationException
    FJ --> U : mensaje de la excepción
  else datos válidos
    MB -> VD : ObtenerPorId(movimiento.VinoId)
    activate VD
    VD -> DB : VINO_OBTENER_POR_ID(@id)
    DB --> VD : filas
    VD --> MB : Vino (o null)
    deactivate VD

    alt 3b. el vino no existe, no está autorizado o no está activo
      MB --> FJ : InvalidOperationException
      FJ --> U : mensaje de la excepción
    else vino autorizado y activo
      note right of MB : Tipo = Entrada; Fecha = ahora; Responsable = sesion.Usuario
      MB -> MD : Insertar(movimiento)
      activate MD
      MD -> DB : MOVIMIENTO_STOCK_INSERTAR(@vino_id,@tipo,@cantidad,\n@motivo,@responsable,@referencia_tipo,@referencia_id)
      DB --> MD : filas afectadas
      MD --> MB : void
      deactivate MD
      MB -> BB : RegistrarAccion(sesion.Usuario,\n"AJUSTE_STOCK:" + vino.Codigo + ":+" + cantidad)
      activate BB
      BB -> TD : Registrar(usuario, accion)
      activate TD
      TD -> DB : BITACORA_INSERTAR(@usuario,@accion)
      DB --> TD : filas afectadas
      TD --> BB : void
      deactivate TD
      BB --> MB : void
      deactivate BB
      MB --> FJ : void
      FJ --> U : "Ajuste de inventario registrado correctamente."
    end
  end
  deactivate MB
end

opt el ajuste fue registrado
  FJ -> MB : ObtenerStockActual(vino.Id)
  activate MB
  MB -> MD : ObtenerStockActual(vinoId)
  activate MD
  MD -> DB : STOCK_ACTUAL_OBTENER(@vino_id)
  DB --> MD : STOCK
  MD --> MB : int
  deactivate MD
  MB --> FJ : int
  deactivate MB
  FJ -> MB : ObtenerMovimientos(vino.Id)
  activate MB
  MB -> MD : ListarPorVino(vinoId)
  activate MD
  MD -> DB : MOVIMIENTO_STOCK_LISTAR_POR_VINO(@vino_id)
  DB --> MD : filas
  MD --> MB : List<MovimientoStock>
  deactivate MD
  MB --> FJ : List<MovimientoStock>
  deactivate MB
  FJ -> FJ : refrescar stock actual y movimientos
end
deactivate FJ

@enduml
