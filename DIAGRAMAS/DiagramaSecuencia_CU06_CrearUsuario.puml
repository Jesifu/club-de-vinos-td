@startuml DiagramaSecuencia_CU06_CrearUsuario

title CU-06 — Crear Usuario — Diagrama de Secuencia

skinparam shadowing false
skinparam roundcorner 6
skinparam sequenceArrowThickness 1.2
skinparam sequenceMessageAlign center
hide footbox
scale 0.7

' ─────────────────────────────────────────
' Participantes en orden de aparición
' ─────────────────────────────────────────
actor       ":Administrador"       as A
participant ":frmAdminUsuarios"    as FA #FEFECE
participant ":frmNuevoUsuario"     as FN #FEFECE
participant ":PerfilBLL"           as PB #E8F4E8
participant ":UsuarioBLL"          as UB #E8F4E8
participant ":IntegridadBLL"       as IB #E8F4E8
participant ":UsuarioHistorialBLL" as UH #E8F4E8
participant ":Hasher"              as H  #F4E8E8
participant ":SessionManager"      as SM #F4E8E8
participant ":PerfilDAL"           as PD #E8E8F4
participant ":UsuarioDAL"          as UD #E8E8F4
participant ":UsuarioPerfilDAL"    as UPD #E8E8F4
participant ":UsuarioHistorialDAL" as UHD #E8E8F4
participant ":IntegridadDAL"       as IND #E8E8F4
database    ":DB"                  as DB #EEEEEE

note over FA
  Precondición: sesión activa,
  permiso "Administrar usuarios".
end note

== 1. Apertura del formulario ==

A -> FA : click "Nuevo"
FA -> FN : new frmNuevoUsuario()\n.ShowDialog()
activate FN

FN -> PB : ListarRolesParaCombo()
PB -> PD : ListarParaCombo()
PD -> DB : ROL_LISTAR_PARA_COMBO
DB --> PD : filas de ROL
PD --> PB : List<Rol>
PB --> FN : List<Rol>
FN -> FN : cboRol.DataSource = roles\n(combo poblado dinámicamente)

== 2. Ingreso de datos ==

A -> FN : ingresar nombre de usuario, contraseña,\nnombre, apellido, teléfono (opcional),\nemail (opcional) y seleccionar rol\n+ click Aceptar

opt 3a. nombre o contraseña vacíos
  FN --> A : "Ingresá un nombre de usuario." /\n"Ingresá una contraseña."
  note right of FN : el flujo vuelve al paso 3\n(el formulario sigue abierto)
end

opt 3b. no se seleccionó ningún rol
  FN --> A : "Seleccioná un rol."
  note right of FN : el flujo vuelve al paso 3\n(el formulario sigue abierto)
end

alt 4a. el administrador cancela
  FN --> FA : DialogResult.Cancel
  deactivate FN
  note right of FA : no se crea ningún registro\n(fin del caso de uso)

else el administrador acepta
  FN -> FN : DialogResult = OK
  FN --> FA : DialogResult.OK
  deactivate FN

  == 3. Alta del usuario ==

  FA -> UB : Crear(usuario, contrasena, rolId,\nnombre, apellido, telefono, email)
  activate UB

  UB -> H : Hashear(contrasena)
  H --> UB : hash SHA-256

  UB -> UD : Crear(usuario, hash, rolId,\nnombre, apellido, telefono, email)
  UD -> DB : USUARIO_CREAR(@usuario, @pass, @rol_id,\n@nombre, @apellido, @telefono, @email)
  note right of DB
    el SP inserta con
    INTENTOS_FALLIDOS = 0
    y BLOQUEADO = 0
  end note
  DB --> UD : OK = 1 / 0
  UD --> UB : bool

  alt 7a. el nombre de usuario ya existe (OK = 0)
    UB --> FA : false
    FA --> A : "El nombre de usuario ya existe."
    note right of FA : el flujo vuelve al paso 3

  else alta exitosa (OK = 1)
    UB -> IB : RecalcularIntegridadUsuarios()
    activate IB
    IB -> IND : ListarUsuariosParaIntegridad()
    IND -> DB : USUARIO_LISTAR_PARA_INTEGRIDAD
    DB --> IND : filas de USUARIO
    IND --> IB : DataTable
    IB -> UPD : ListarPerfilesPorUsuario(id)\n(por cada usuario, atributo PERFILES)
    UPD -> DB : USUARIO_PERFIL_LISTAR(@usuario_id)
    DB --> UPD : PERFIL_ID
    UPD --> IB : List<int>
    IB -> IB : CalculadorDVH.Calcular(atributos)\nCalculadorDVH.CalcularVertical(filas, col)
    IB -> IND : ActualizarDVHUsuario(id, dvh)\n(por cada usuario)
    IND -> DB : USUARIO_ACTUALIZAR_DVH(@id, @dvh)
    IB -> IND : ActualizarDVV("USUARIO", columna, dvv)\n(por cada columna)
    IND -> DB : DVV_ACTUALIZAR(@tabla, @columna, @dvv)
    IB --> UB : (DVH / DVV recalculados)
    deactivate IB

    UB -> SM : getUsuario()
    SM --> UB : administrador actual

    UB -> UD : ObtenerIdPorNombre(usuario)
    UD -> DB : USUARIO_OBTENER_ID_POR_NOMBRE(@usuario)
    DB --> UD : ID
    UD --> UB : int?

    UB -> UH : RegistrarCambio(usuarioId, "ALTA", admin)
    UH -> UD : ObtenerPorId(usuarioId)
    UD -> DB : USUARIO_OBTENER_POR_ID(@id)
    DB --> UD : fila de USUARIO
    UD --> UH : BE.USUARIO
    UH -> UPD : ListarPerfilesPorUsuario(usuarioId)
    UPD -> DB : USUARIO_PERFIL_LISTAR(@usuario_id)
    DB --> UPD : PERFIL_ID
    UPD --> UH : List<int> perfiles
    UH -> UHD : Insertar(UsuarioHistorial)
    UHD -> DB : USUARIO_HISTORIAL_INSERTAR(snapshot,\n@tipo_cambio, @realizado_por)

    UB --> FA : true
    FA --> A : "Usuario creado correctamente."
    FA -> UB : ListarPaginado(_busquedaActual,\n_paginaActual, TAMANIO_PAGINA)
    UB -> UD : ListarPaginado(busqueda, pagina, tamanio)
    UD -> DB : USUARIO_LISTAR_PAGINADO(@busqueda,\n@pagina, @tamanio)
    DB --> UD : filas + TOTAL_FILAS
    UD --> UB : PaginaResultado<USUARIO>
    UB --> FA : PaginaResultado<USUARIO>
    FA -> FA : refrescar grilla
  end
  deactivate UB
end

@enduml
