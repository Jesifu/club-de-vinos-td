@startuml DiagramaSecuencia_CU22_AutorizarAltaVino

title CU-22 — Autorizar o Rechazar Alta de Vino — Diagrama de Secuencia

skinparam shadowing false
skinparam roundcorner 6
skinparam sequenceArrowThickness 1.2
skinparam sequenceMessageAlign center
hide footbox
scale 0.65

actor       ":Administrador"           as A
participant ":frmAutorizarAltaVino"    as FA #FEFECE
participant ":VinoBLL"                 as VB #E8F4E8
participant ":BitacoraBLL"             as BB #E8F4E8
participant ":SolicitudAutorizacionDAL" as SD #E8E8F4
participant ":BitacoraDAL"             as TD #E8E8F4
database    ":DB"                      as DB #EEEEEE

note over FA
  Precondición: sesión activa; permiso "Autorizar alta de vinos";
  existe al menos una solicitud de alta Pendiente.
end note

A -> FA : abrir "Autorizar alta de vino"
activate FA
FA -> VB : ListarSolicitudesPendientes(TipoSolicitud.Alta)
activate VB
VB -> SD : ListarPendientes(TipoSolicitud.Alta)
activate SD
SD -> DB : SOLICITUD_LISTAR_PENDIENTES(@tipo)
DB --> SD : filas (solicitud + emisor + datos del vino)
SD --> VB : List<SolicitudAutorizacion>
deactivate SD
VB --> FA : List<SolicitudAutorizacion>
deactivate VB
FA -> FA : mostrar grilla de solicitudes

A -> FA : seleccionar una solicitud
FA -> FA : MostrarDetalle(): cargar en el panel de detalle los datos\nde la solicitud y del vino (SKU, nombre, bodega, varietal, añada,\nprecio, stock mínimo, maridaje, puntaje)
FA -> FA : habilitar "Autorizar" y "Rechazar alta" solo si\nsolicitud.EmisorId <> sesion.Id (RN-01, capa UI)

alt el administrador autoriza el alta ("Autorizar")
  A -> FA : click "Autorizar"
  FA -> VB : AutorizarAlta(solicitud.Id, sesion)
  activate VB
  VB -> VB : ObtenerSolicitudPendiente(solicitudId, TipoSolicitud.Alta)
  VB -> SD : ObtenerPorId(solicitudId)
  activate SD
  SD -> DB : SOLICITUD_OBTENER_POR_ID(@id)
  DB --> SD : filas
  SD --> VB : SolicitudAutorizacion (o null)
  deactivate SD

  alt 3a. la solicitud no existe, ya fue resuelta o no es de alta
    VB --> FA : InvalidOperationException
    FA --> A : mensaje de la excepción
  else 3b. el administrador es quien emitió la solicitud (RN-01, capa BLL)
    VB --> FA : InvalidOperationException
    FA --> A : mensaje de la excepción
  else solicitud pendiente y separación de funciones OK
    VB -> SD : AprobarAlta(solicitudId, sesion.Id)
    activate SD
    SD -> DB : SOLICITUD_APROBAR_ALTA(@solicitud_id,@resolutor_id)
    note right of DB : en una sola transacción, bloqueando primero VINO:\nsolicitud Aprobada + VINO de Pendiente a Activo
    DB --> SD : FILAS
    SD --> VB : int
    deactivate SD

    alt 3c. 0 filas (RN-01, backstop de la SP, o la solicitud cambió de estado)
      VB --> FA : InvalidOperationException
      FA --> A : mensaje de la excepción
    else 1 fila
      VB -> BB : RegistrarAccion(sesion.Usuario,\n"AUTORIZACION_VINO:" + solicitud.VinoCodigo)
      activate BB
      BB -> TD : Registrar(usuario, accion)
      activate TD
      TD -> DB : BITACORA_INSERTAR(@usuario,@accion)
      DB --> TD : filas afectadas
      TD --> BB : void
      deactivate TD
      BB --> VB : void
      deactivate BB
      VB --> FA : void
      FA --> A : "Vino autorizado correctamente."
    end
  end
  deactivate VB
else el administrador rechaza el alta ("Rechazar alta")
  A -> FA : escribir el motivo de rechazo + click "Rechazar alta" + confirmar

  alt 4a. el motivo está vacío (capa UI)
    FA --> A : "Debe indicar el motivo del rechazo."
  else motivo informado
    FA -> VB : RechazarAlta(solicitud.Id, motivo, sesion)
    activate VB
    VB -> VB : ValidarMotivo(motivo)\n(recorta; 1 a 200 caracteres)
    VB -> VB : ObtenerSolicitudPendiente(solicitudId, TipoSolicitud.Alta)
    VB -> SD : ObtenerPorId(solicitudId)
    activate SD
    SD -> DB : SOLICITUD_OBTENER_POR_ID(@id)
    DB --> SD : filas
    SD --> VB : SolicitudAutorizacion (o null)
    deactivate SD

    alt 4b. motivo inválido, solicitud inexistente o ya resuelta
      VB --> FA : InvalidOperationException
      FA --> A : mensaje de la excepción
    else 4c. el administrador es quien emitió la solicitud (RN-01, capa BLL)
      VB --> FA : InvalidOperationException
      FA --> A : mensaje de la excepción
    else solicitud pendiente y separación de funciones OK
      VB -> SD : RechazarAlta(solicitudId, sesion.Id, motivo)
      activate SD
      SD -> DB : SOLICITUD_RECHAZAR_ALTA(@solicitud_id,@resolutor_id,@motivo)
      note right of DB : en una sola transacción, bloqueando primero VINO:\nsolicitud Rechazada (con motivo) + VINO de Pendiente a Rechazado
      DB --> SD : FILAS
      SD --> VB : int
      deactivate SD

      alt 4d. 0 filas (RN-01, backstop de la SP, o la solicitud cambió de estado)
        VB --> FA : InvalidOperationException
        FA --> A : mensaje de la excepción
      else 1 fila
        VB -> BB : RegistrarAccion(sesion.Usuario,\n"RECHAZO_ALTA_VINO:" + solicitud.VinoCodigo)
        activate BB
        BB -> TD : Registrar(usuario, accion)
        activate TD
        TD -> DB : BITACORA_INSERTAR(@usuario,@accion)
        DB --> TD : filas afectadas
        TD --> BB : void
        deactivate TD
        BB --> VB : void
        deactivate BB
        VB --> FA : void
        FA --> A : "Alta rechazada. El vino quedó rechazado."
      end
    end
    deactivate VB
  end
end

FA -> VB : ListarSolicitudesPendientes(TipoSolicitud.Alta)
activate VB
VB -> SD : ListarPendientes(TipoSolicitud.Alta)
activate SD
SD -> DB : SOLICITUD_LISTAR_PENDIENTES(@tipo)
DB --> SD : filas
SD --> VB : List<SolicitudAutorizacion>
deactivate SD
VB --> FA : List<SolicitudAutorizacion>
deactivate VB
FA -> FA : refrescar grilla y detalle (tras un resultado exitoso o un fallo\nde la BLL; el motivo vacío no recarga)
deactivate FA

@enduml
