@startuml DiagramaSecuencia_CU18_EliminarIdioma

title CU-18 — Eliminar Idioma — Diagrama de Secuencia

skinparam shadowing false
skinparam roundcorner 6
skinparam sequenceArrowThickness 1.2
skinparam ParticipantPadding 14
skinparam sequenceMessageAlign center
hide footbox
scale 0.85

' ─────────────────────────────────────────
' Participantes en orden de aparición
' ─────────────────────────────────────────
actor       ":Administrador" as A
participant ":frmIdiomas"    as FI #FEFECE
participant ":IdiomaManager" as IM #F4E8E8
participant ":IdiomaBLL"     as IB #E8F4E8
database    ":DB"            as DB #E8E8F4

note over FI
  Precondición: sesión activa,
  permiso "Gestión de idiomas",
  existe al menos un idioma.
end note

' ─────────────────────────────────────────
' SELECCIÓN Y SOLICITUD
' ─────────────────────────────────────────
== 1. Selección y solicitud ==

A -> FI : seleccionar un idioma en la grilla
FI -> FI : dgvIdiomas_SelectionChanged\n→ _idiomaSeleccionado

A -> FI : click "Eliminar"

opt 1a. ningún idioma seleccionado
  FI --> A : "Seleccioná un idioma." (Aviso)
  note right of FI : el caso de uso termina
end

' ─────────────────────────────────────────
' VALIDACIONES DE NEGOCIO
' ─────────────────────────────────────────
== 1b. Validaciones de negocio ==

opt 1b-1. el idioma es el predeterminado del sistema
  FI --> A : "No se puede eliminar el idioma\npredeterminado del sistema." (Aviso)
  note right of FI
    RN-03: el idioma marcado como
    predeterminado (IDIOMA.PREDETERMINADO = 1)
    nunca puede eliminarse.
  end note
  note right of FI : el caso de uso termina
end

opt 1b-2. el idioma está en uso por algún usuario
  FI -> IB : EstaEnUso(id)
  IB -> DB : IDIOMA_ESTA_EN_USO(id)
  DB --> IB : cantidad de usuarios
  IB --> FI : bool

  FI --> A : "No se puede eliminar un idioma\nque está en uso por algún usuario." (Aviso)
  note right of FI
    RN-04: no se puede eliminar un idioma
    asignado a algún usuario (USUARIO.IDIOMA_ID),
    sin importar si es el idioma activo
    de la sesión actual.
  end note
  note right of FI : el caso de uso termina
end

FI --> A : solicitar confirmación\n("¿Eliminar el idioma 'X'?\nSe borrarán todas sus traducciones.")

alt 4a. el administrador cancela
  A --> FI : No
  note right of FI : el caso de uso termina\n(no se elimina el idioma)

else el administrador confirma
  A --> FI : Sí

  ' ─────────────────────────────────────────
  ' DESACTIVACIÓN SI ES EL IDIOMA ACTIVO
  ' ─────────────────────────────────────────
  == 2. Desactivación si es el idioma activo ==

  FI -> IM : IdiomaActivo
  IM --> FI : idioma activo (o null)

  opt el idioma seleccionado es el activo
    FI -> IM : CambiarIdioma(null, null)
    IM -> IM : Notificar()\n→ ActualizarIdioma() en cada\nformulario registrado
    note right of IM
      RN-02: si el idioma a eliminar
      es el activo, primero se
      desactiva en IdiomaManager
      (los formularios vuelven a
      sus textos de diseño por
      defecto) antes de borrar
      la BD.
    end note
  end

  ' ─────────────────────────────────────────
  ' ELIMINACIÓN
  ' ─────────────────────────────────────────
  == 3. Eliminación ==

  FI -> IB : Eliminar(id)
  IB -> DB : DELETE FROM CONTROL_IDIOMA\nWHERE IDIOMA_ID = id
  IB -> DB : DELETE FROM IDIOMA WHERE ID = id
  note right of DB
    RN-01: operación irreversible —
    se borran el idioma y todas
    sus traducciones.
  end note

  FI -> FI : _idiomaSeleccionado = null
  FI -> FI : dgvTraducciones.DataSource = null

  ' ─────────────────────────────────────────
  ' ACTUALIZACIÓN DE LA GRILLA
  ' ─────────────────────────────────────────
  == 4. Actualización de la grilla ==

  FI -> IB : ListarTodos()
  IB -> DB : SELECT * FROM IDIOMA
  DB --> IB : filas
  IB --> FI : List<IDIOMA>
  FI -> FI : dgvIdiomas.DataSource = idiomas
  FI --> A : grilla de idiomas refrescada,\ngrilla de traducciones vacía
end

@enduml
