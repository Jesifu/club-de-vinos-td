@startuml DiagramaSecuencia_CU11_RestaurarUsuarioHistorial

title CU-11 — Restaurar Usuario desde Historial (Rollback) — Diagrama de Secuencia

skinparam shadowing false
skinparam roundcorner 6
skinparam sequenceArrowThickness 1.2
skinparam sequenceMessageAlign center
hide footbox
scale 0.75

' ─────────────────────────────────────────
' Participantes en orden de aparición
' ─────────────────────────────────────────
actor       ":Administrador"         as A
participant ":frmHistorial\nUsuario" as FH #FEFECE
participant ":UsuarioHistorialBLL"   as UH #E8F4E8
participant ":IntegridadBLL"         as IB #E8F4E8
participant ":SessionManager"        as SM #F4E8E8
participant ":UsuarioHistorialDAL"   as UHD #E8E8F4
participant ":UsuarioDAL"            as UD #E8E8F4
participant ":UsuarioPerfilDAL"      as UPD #E8E8F4
participant ":IntegridadDAL"         as IND #E8E8F4
database    ":DB"                    as DB #EEEEEE

note over FH
  Precondición: dentro de CU-10,
  con una entrada del historial
  seleccionada cuyo TipoCambio
  no es BAJA (botón Rollback
  habilitado por CU-10).
end note

== 1. Solicitud ==

A -> FH : click "Rollback"

opt 2a. la entrada seleccionada es de tipo ROLLBACK
  FH --> A : "No se puede restaurar una versión\nque ya es un rollback."\n("Operación no permitida")
  note right of FH
    RN-04: las entradas ROLLBACK
    no son restaurables (evita
    cadenas de rollbacks
    recursivos). Validación en UI,
    antes de pedir confirmación.
  end note
  note right of FH : el caso de uso termina
end

== 2. Confirmación ==

FH --> A : solicitar confirmación\n("¿Restaurar el estado del usuario 'X'\na la versión del dd/MM/yyyy HH:mm?\nTipo de cambio registrado: ...\nNota: la contraseña NO se restaurará.")

alt 4a. el administrador cancela
  A --> FH : No
  note right of FH : el caso de uso termina\n(no se aplica ningún cambio)

else el administrador confirma
  A --> FH : Sí

  == 3. Restauración ==

  FH -> SM : getUsuario()
  SM --> FH : administrador actual

  FH -> UH : Rollback(historialId, admin)
  activate UH

  UH -> UHD : ObtenerPorId(historialId)
  UHD -> DB : USUARIO_HISTORIAL_OBTENER(@id)
  DB --> UHD : fila de USUARIO_HISTORIAL / vacío
  UHD --> UH : UsuarioHistorial / null

  alt EX-01. snapshot no encontrado
    UH --> FH : throw InvalidOperationException\n("Versión histórica no encontrada.")
    FH --> A : MessageBox de error

  else snapshot encontrado

    alt EX-02. snapshot.TipoCambio == "ROLLBACK"\n(defensa en profundidad)
      UH --> FH : throw InvalidOperationException\n("No se puede restaurar una versión\nque ya es un rollback.")
      FH --> A : MessageBox de error
      note right of UH
        RN-04: validación de respaldo
        en la capa de negocio, por si
        se invoca Rollback() sin pasar
        por la UI.
      end note

    else snapshot restaurable
      UH -> UD : AplicarEstado(usuarioId, snapshot.Rol,\nsnapshot.Bloqueado, snapshot.IntentosFallidos,\nsnapshot.RolId)
      UD -> DB : USUARIO_APLICAR_ESTADO(@id, @rol, @bloqueado,\n@intentos_fallidos, @rol_id)
      note right of DB
        RN-02: la contraseña (PASS)
        nunca se restaura — no se
        almacena en el historial.
      end note

      UH -> UPD : BorrarTodos(usuarioId)
      UPD -> DB : USUARIO_PERFIL_BORRAR_TODOS(@usuario_id)
      loop por cada perfil del snapshot
        UH -> UPD : Asignar(usuarioId, perfilId)
        UPD -> DB : USUARIO_PERFIL_ASIGNAR(@usuario_id, @perfil_id)
      end

      UH -> UD : ActualizarDatos(usuarioId, snapshot.Nombre,\nsnapshot.Apellido, snapshot.Telefono,\nsnapshot.Email)
      UD -> DB : USUARIO_ACTUALIZAR_DATOS(@id, @nombre, @apellido,\n@telefono, @email)
      note right of DB
        RN-05: los campos personales
        (Nombre, Apellido, Teléfono,
        Email) también se restauran
        desde el snapshot histórico.
      end note

      UH -> UH : RegistrarCambio(usuarioId,\n"ROLLBACK", admin, historialId)
      UH -> UD : ObtenerPorId(usuarioId)
      UD -> DB : USUARIO_OBTENER_POR_ID(@id)
      DB --> UD : fila de USUARIO
      UD --> UH : BE.USUARIO
      UH -> UPD : ListarPerfilesPorUsuario(usuarioId)
      UPD -> DB : USUARIO_PERFIL_LISTAR(@usuario_id)
      DB --> UPD : PERFIL_ID
      UPD --> UH : List<int> perfiles
      UH -> UHD : Insertar(UsuarioHistorial)
      UHD -> DB : USUARIO_HISTORIAL_INSERTAR(snapshot,\n@tipo_cambio = "ROLLBACK",\n@version_origen = historialId)
      note right of DB
        RN-03: cada rollback genera
        una entrada nueva; los
        snapshots anteriores nunca
        se borran.
      end note

      UH -> IB : RecalcularIntegridadUsuarios()
      activate IB
      IB -> IND : ListarUsuariosParaIntegridad()
      IND -> DB : USUARIO_LISTAR_PARA_INTEGRIDAD
      DB --> IND : filas de USUARIO
      IND --> IB : DataTable
      IB -> UPD : ListarPerfilesPorUsuario(id)\n(por cada usuario, atributo PERFILES)
      UPD -> DB : USUARIO_PERFIL_LISTAR(@usuario_id)
      DB --> UPD : PERFIL_ID
      UPD --> IB : List<int>
      IB -> IB : CalculadorDVH.Calcular(atributos)\nCalculadorDVH.CalcularVertical(filas, col)
      IB -> IND : ActualizarDVHUsuario(id, dvh)\n(por cada usuario)
      IND -> DB : USUARIO_ACTUALIZAR_DVH(@id, @dvh)
      IB -> IND : ActualizarDVV("USUARIO", columna, dvv)\n(por cada columna)
      IND -> DB : DVV_ACTUALIZAR(@tabla, @columna, @dvv)
      IB --> UH : (DVH / DVV recalculados)
      deactivate IB

      UH -> SM : getUsuario()
      SM --> UH : usuarioSesion

      opt usuarioSesion != null\nAND usuarioSesion.Id == snapshot.UsuarioId
        UH -> UD : ObtenerPorId(usuarioId)
        UD -> DB : USUARIO_OBTENER_POR_ID(@id)
        DB --> UD : fila de USUARIO
        UD --> UH : usuarioActualizado
        UH -> SM : setUsuario(usuarioActualizado)

        UH -> UPD : ListarPermisosDeUsuario(usuarioId)
        UPD -> DB : USUARIO_PERMISOS_LISTAR(@usuario_id)
        DB --> UPD : NOMBRE de cada permiso
        UPD --> UH : permisosActualizados
        UH -> SM : setPermisos(permisosActualizados)

        note right of SM
          RN-06: si el rollback afecta al
          propio administrador logueado,
          su SessionManager se refresca
          en caliente (usuario y permisos)
          para que no haga falta
          desloguearse y volver a entrar.
        end note
      end

      UH --> FH : (rollback aplicado)
      deactivate UH

      FH --> A : "Estado restaurado correctamente."
      FH -> FH : CargarHistorial()\n(refresca la grilla)
      FH -> UH : ObtenerHistorialPaginado(usuario.Id,\n_paginaActual, TAMANIO_PAGINA)
      UH -> UHD : ListarPorUsuarioPaginado(usuarioId,\npagina, tamanio)
      UHD -> DB : USUARIO_HISTORIAL_LISTAR_PAGINADO(\n@usuario_id, @pagina, @tamanio)
      DB --> UHD : filas + TOTAL_FILAS
      UHD --> UH : PaginaResultado<UsuarioHistorial>
      UH --> FH : PaginaResultado<UsuarioHistorial>
    end
  end
end

note over UH, DB
  Relación «include» en CU-02 — Restaurar
  Integridad: se invoca este flujo para cada
  usuario afectado al elegir "Restaurar
  desde historial".
end note

@enduml
