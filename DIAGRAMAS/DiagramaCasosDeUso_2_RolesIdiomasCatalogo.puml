@startuml DiagramaCasosDeUso_2_RolesIdiomasCatalogo
left to right direction
skinparam shadowing false
skinparam roundcorner 6
scale 1.6

actor Usuario
actor Administrador
Administrador --|> Usuario

rectangle "Gestion de Roles y Permisos" #E8E8F4 {
  usecase "Crear Rol" as CU12
  usecase "Eliminar Rol" as CU13
  usecase "Cambiar Padre de Rol" as CU14
  usecase "Asignar Permisos\na Rol" as CU15
}

rectangle "Gestion de Idiomas" #F4E8E8 {
  usecase "Crear Idioma" as CU16
  usecase "Editar Idioma" as CU17
  usecase "Eliminar Idioma" as CU18
  usecase "Cargar o Editar\nTraducciones" as CU19
}

rectangle "Auditoria" #FFF0E0 {
  usecase "Ver Bitacora" as CU20
}

rectangle "Gestion de Catalogo y Stock de Vinos" #F0E8F8 {
  usecase "Proponer y Autorizar\nAlta de Vino" as CU21
  usecase "Registrar Movimiento\nde Stock" as CU22
  usecase "Solicitar y Autorizar\nDescontinuacion de Vino" as CU23
  usecase "Consultar Alerta de\nStock Minimo" as CU24
}

Usuario -- CU22
Usuario -- CU24
Usuario -- CU21
Usuario -- CU23

Administrador -- CU12
Administrador -- CU13
Administrador -- CU14
Administrador -- CU15
Administrador -- CU16
Administrador -- CU17
Administrador -- CU18
Administrador -- CU19
Administrador -- CU20
Administrador -- CU21
Administrador -- CU23
@enduml
