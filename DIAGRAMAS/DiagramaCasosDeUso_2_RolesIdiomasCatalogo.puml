@startuml DiagramaCasosDeUso_2_RolesIdiomasCatalogo
left to right direction
skinparam shadowing false
skinparam roundcorner 6
scale 1.6

actor Usuario
actor Administrador
Administrador --|> Usuario

rectangle "Gestion de Roles y Permisos" #E8E8F4 {
  usecase "Crear Rol" as CU12
  usecase "Eliminar Rol" as CU13
  usecase "Cambiar Padre de Rol" as CU14
  usecase "Asignar Permisos\na Rol" as CU15
}

rectangle "Gestion de Idiomas" #F4E8E8 {
  usecase "Crear Idioma" as CU16
  usecase "Editar Idioma" as CU17
  usecase "Eliminar Idioma" as CU18
  usecase "Cargar o Editar\nTraducciones" as CU19
}

rectangle "Auditoria" #FFF0E0 {
  usecase "Ver Bitacora" as CU20
}

rectangle "Gestion de Catalogo y Stock de Vinos" #F0E8F8 {
  usecase "Proponer Alta\nde Vino" as CU21
  usecase "Autorizar Alta\nde Vino" as CU22
