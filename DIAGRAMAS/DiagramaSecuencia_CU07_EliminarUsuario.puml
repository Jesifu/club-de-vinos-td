@startuml DiagramaSecuencia_CU07_EliminarUsuario

title CU-07 — Eliminar Usuario — Diagrama de Secuencia

skinparam shadowing false
skinparam roundcorner 6
skinparam sequenceArrowThickness 1.2
skinparam ParticipantPadding 14
skinparam sequenceMessageAlign center
hide footbox
scale 0.85

' ─────────────────────────────────────────
' Participantes en orden de aparición
' ─────────────────────────────────────────
actor       ":Administrador"       as A
participant ":frmAdminUsuarios"    as FA #FEFECE
participant ":UsuarioBLL"          as UB #E8F4E8
participant ":SessionManager"      as SM #F4E8E8
participant ":UsuarioHistorialBLL" as UH #E8F4E8
participant ":IntegridadBLL"       as IB #E8F4E8
database    ":DB"                  as DB #E8E8F4

note over FA
  Precondición: sesión activa,
  permiso "Administrar usuarios".
end note

' ─────────────────────────────────────────
' SELECCIÓN Y SOLICITUD
' ─────────────────────────────────────────
== 1. Selección y solicitud ==

A -> FA : seleccionar usuario en la grilla\n+ click "Eliminar"

opt 1a. ningún usuario seleccionado
  FA --> A : "Seleccioná un usuario."
  note right of FA : el caso de uso termina
end

' ─────────────────────────────────────────
' VALIDACIONES
' ─────────────────────────────────────────
== 2. Validaciones ==

FA -> SM : getUsuario()
SM --> FA : usuarioActual

alt 3a. el usuario seleccionado es el propio administrador
  FA --> A : "No podés eliminar tu propio usuario."
  note right of FA : el caso de uso termina

else el usuario seleccionado es distinto al propio
  FA --> A : solicitar confirmación\n("¿Eliminar al usuario 'X'?\nEsta acción no se puede deshacer.")

  alt 5a. el administrador cancela
    A --> FA : No
    note right of FA : el caso de uso termina\n(no se elimina al usuario)

  else el administrador confirma
    A --> FA : Sí

    ' ─────────────────────────────────────────
    ' ELIMINACIÓN
    ' ─────────────────────────────────────────
    == 3. Eliminación ==

    FA -> UB : Eliminar(id)
    activate UB

    UB -> SM : getUsuario()
    SM --> UB : administrador actual

    UB -> UH : RegistrarCambio(id, "BAJA", admin)
    note right of UH
      Snapshot del último
      estado conocido (RN-02),
      registrado antes de
      eliminar el registro.
    end note
    UH -> DB : insertar snapshot en USUARIO_HISTORIAL

    UB -> DB : USUARIO_ELIMINAR(id)
    note right of DB
      Cascada del SP: borra
      también las filas del
      usuario en USUARIO_PERFIL
      (RN-04). USUARIO_HISTORIAL
      no tiene FK (RN-03).
    end note

    UB -> IB : RecalcularIntegridadUsuarios()
    IB -> DB : actualizar DVH / DVV
    deactivate UB

    FA -> DB : CargarUsuarios()\n(USUARIO_LISTAR_PAGINADO,\ncon búsqueda y paginado)
    DB --> FA : página de usuarios
    FA -> FA : refrescar grilla
  end
end

@enduml
