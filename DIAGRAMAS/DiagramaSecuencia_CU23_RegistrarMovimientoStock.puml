@startuml DiagramaSecuencia_CU23_RegistrarMovimientoStock

title CU-23 — Registrar Entrada de Stock — Diagrama de Secuencia

skinparam shadowing false
skinparam roundcorner 6
skinparam sequenceArrowThickness 1.2
skinparam sequenceMessageAlign center
hide footbox
scale 0.7

actor       ":Usuario"                    as U
participant ":frmRegistrarEntradaStock"   as FE #FEFECE
participant ":VinoBLL"                    as VB #E8F4E8
participant ":MovimientoStockBLL"         as MB #E8F4E8
participant ":BitacoraBLL"                as BB #E8F4E8
participant ":VinoDAL"                    as VD #E8E8F4
participant ":MovimientoStockDAL"         as MD #E8E8F4
participant ":BitacoraDAL"                as TD #E8E8F4
database    ":DB"                         as DB #EEEEEE

note over FE
  Precondición: sesión activa; permiso "Gestionar catálogo de vinos";
  existe al menos un vino autorizado y activo.
end note

U -> FE : abrir "Registrar entrada de stock"
activate FE
FE -> VB : ListarAutorizados()
activate VB
VB -> VD : ListarAutorizados()
activate VD
VD -> DB : VINO_LISTAR_AUTORIZADOS
DB --> VD : filas
VD --> VB : List<Vino>
deactivate VD
VB --> FE : List<Vino>
deactivate VB
FE -> FE : cboVino.DataSource = vinos; seleccionar el primero

FE -> MB : ObtenerStockActual(vino.Id)
activate MB
MB -> MD : ObtenerStockActual(vinoId)
activate MD
MD -> DB : STOCK_ACTUAL_OBTENER(@vino_id)
DB --> MD : STOCK (suma de entradas menos salidas)
MD --> MB : int
deactivate MD
MB --> FE : int
deactivate MB

FE -> MB : ObtenerMovimientos(vino.Id)
activate MB
MB -> MD : ListarPorVino(vinoId)
activate MD
MD -> DB : MOVIMIENTO_STOCK_LISTAR_POR_VINO(@vino_id)
DB --> MD : filas
MD --> MB : List<MovimientoStock>
deactivate MD
MB --> FE : List<MovimientoStock>
deactivate MB
FE -> FE : mostrar stock actual y grilla de movimientos

U -> FE : seleccionar vino, ingresar cantidad y motivo\n+ click "Registrar entrada"
FE -> MB : RegistrarEntrada(movimiento, sesion)
activate MB

alt 2a. cantidad <= 0 o motivo vacío
  MB --> FE : InvalidOperationException
  FE --> U : mensaje de la excepción
  note right of FE : el flujo vuelve a la carga de datos
else datos válidos
  MB -> VD : ObtenerPorId(movimiento.VinoId)
  activate VD
  VD -> DB : VINO_OBTENER_POR_ID(@id)
  DB --> VD : filas
  VD --> MB : Vino (o null)
  deactivate VD

  alt 2b. el vino no existe, no está autorizado o no está activo
    MB --> FE : InvalidOperationException
    FE --> U : mensaje de la excepción
  else vino autorizado y activo
    note right of MB : Tipo = Entrada; Fecha = ahora;\nResponsable = sesion.Usuario
    MB -> MD : Insertar(movimiento)
    activate MD
    MD -> DB : MOVIMIENTO_STOCK_INSERTAR(@vino_id,@tipo,@cantidad,\n@motivo,@responsable,@referencia_tipo,@referencia_id)
    DB --> MD : ID del movimiento
    MD --> MB : void
    deactivate MD
    MB -> BB : RegistrarAccion(sesion.Usuario,\n"ENTRADA_STOCK:" + vino.Codigo + ":" + cantidad)
    activate BB
    BB -> TD : Registrar(usuario, accion)
    activate TD
    TD -> DB : BITACORA_INSERTAR(@usuario,@accion)
    DB --> TD : filas afectadas
    TD --> BB : void
    deactivate TD
    BB --> MB : void
    deactivate BB
    MB --> FE : void
    deactivate MB
    FE --> U : "Entrada de stock registrada correctamente."

    FE -> MB : ObtenerStockActual(vino.Id)
    activate MB
    MB -> MD : ObtenerStockActual(vinoId)
    activate MD
    MD -> DB : STOCK_ACTUAL_OBTENER(@vino_id)
    DB --> MD : STOCK
    MD --> MB : int
    deactivate MD
    MB --> FE : int
    deactivate MB

    FE -> MB : ObtenerMovimientos(vino.Id)
    activate MB
    MB -> MD : ListarPorVino(vinoId)
    activate MD
    MD -> DB : MOVIMIENTO_STOCK_LISTAR_POR_VINO(@vino_id)
    DB --> MD : filas
    MD --> MB : List<MovimientoStock>
    deactivate MD
    MB --> FE : List<MovimientoStock>
    deactivate MB
    FE -> FE : refrescar stock actual y grilla
  end
end
deactivate FE

@enduml
