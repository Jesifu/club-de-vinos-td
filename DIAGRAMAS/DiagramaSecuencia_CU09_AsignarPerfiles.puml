@startuml DiagramaSecuencia_CU09_AsignarPerfiles

title CU-09 — Asignar Perfiles a Usuario — Diagrama de Secuencia

skinparam shadowing false
skinparam roundcorner 6
skinparam sequenceArrowThickness 1.2
skinparam sequenceMessageAlign center
hide footbox
scale 0.7

' ─────────────────────────────────────────
' Participantes en orden de aparición
' ─────────────────────────────────────────
actor       ":Administrador"        as A
participant ":frmAdminUsuarios"     as FA #FEFECE
participant ":frmAsignar\nPerfiles" as FP #FEFECE
participant ":PerfilBLL"            as PB #E8F4E8
participant ":UsuarioPerfilBLL"     as UP #E8F4E8
participant ":IntegridadBLL"        as IB #E8F4E8
participant ":CalculadorDVH" as CD #F4E8E8
participant ":UsuarioHistorialBLL"  as UH #E8F4E8
participant ":SessionManager"       as SM #F4E8E8
participant ":PerfilDAL"            as PD #E8E8F4
participant ":UsuarioPerfilDAL"     as UPD #E8E8F4
participant ":UsuarioDAL"           as UD #E8E8F4
participant ":UsuarioHistorialDAL"  as UHD #E8E8F4
participant ":IntegridadDAL"        as IND #E8E8F4
database    ":DB"                   as DB #EEEEEE

note over FA
  Precondición: sesión activa,
  permiso "Administrar usuarios";
  frmAdminUsuarios abierto desde frmMenu
  (Administración > Gestión de usuarios);
  el usuario existe y hay al
  menos un rol en el sistema.
end note

== 1. Apertura del formulario ==

A -> FA : seleccionar usuario en la grilla\n+ click "Modificar perfiles"

break 1a. ningún usuario seleccionado
  FA --> A : "Seleccioná un usuario."\n(título "Atención")
  note right of FA : el caso de uso termina
end

FA -> FP : new frmAsignarPerfiles(usuario)\n.ShowDialog()
activate FP

== 2. Carga del árbol de roles ==

FP -> PB : ObtenerArbol()
PB -> PD : ListarRoles()
PD -> DB : ROL_LISTAR_TODOS
DB --> PD : filas de ROL
PD --> PB : List<NodoPermiso>
PB -> PB : armar la jerarquía de roles\n(PadreId → Agregar hijos)
PB -> PD : ListarRolPermisos()
PD -> DB : ROL_PERMISO_LISTAR_TODOS
DB --> PD : filas de ROL_PERMISO + PERMISO
PD --> PB : List<Permiso>
PB -> PB : adjuntar cada permiso a su rol\n(PadreId = ROL_ID → Agregar)
PB --> FP : List<NodoPermiso> (raíces)
FP -> FP : CargarArbolRoles()
note right of FP
  Solo se muestran nodos
  rama (roles), no las hojas
  de permisos del catálogo
  (RT-01): if (!EsHoja()).
end note

FP -> UP : ObtenerPerfilesAsignados(usuario.Id)
UP -> UPD : ListarPerfilesPorUsuario(usuarioId)
UPD -> DB : USUARIO_PERFIL_LISTAR(@usuario_id)
DB --> UPD : PERFIL_ID
UPD --> UP : List<int> asignados
UP --> FP : asignados
FP -> FP : MarcarRolesAsignados():\nmarcar los checks de los\nroles ya asignados

== 3. Edición de la selección ==

A -> FP : marcar / desmarcar roles\nen el árbol

alt 3a. el administrador cierra sin guardar
  A -> FP : click "Cerrar"
  FP -> FP : this.Close()
  FP --> FA : (form cerrado)
  deactivate FP
  note right of FA : las asignaciones existentes\nno se modifican

else el administrador guarda
  A -> FP : click "Guardar"

  == 4. Persistencia de las asignaciones ==

  FP -> FP : recolectar IDs de roles\nmarcados (checkeados)
  FP -> UP : GuardarAsignaciones(usuario.Id, idsSeleccionados)
  activate UP

  UP -> UPD : BorrarTodos(usuarioId)
  UPD -> DB : USUARIO_PERFIL_BORRAR_TODOS(@usuario_id)
  loop por cada id en perfilIds
    UP -> UPD : Asignar(usuarioId, id)
    UPD -> DB : USUARIO_PERFIL_ASIGNAR(@usuario_id, @perfil_id)
  end
  note right of DB
    Reemplazo completo de
    USUARIO_PERFIL — no es
    una operación incremental
    (RT-02). Sin transacción:
    cada llamada abre su
    propia conexión.
  end note

  UP -> IB : RecalcularIntegridadUsuarios()
  activate IB
  IB -> IND : ListarUsuariosParaIntegridad()
  IND -> DB : USUARIO_LISTAR_PARA_INTEGRIDAD
  DB --> IND : filas de USUARIO
  IND --> IB : DataTable
  loop por cada usuario
    IB -> UPD : ListarPerfilesPorUsuario(id)
    UPD -> DB : USUARIO_PERFIL_LISTAR(@usuario_id)
    DB --> UPD : PERFIL_ID
    UPD --> IB : List<int>
    IB -> CD : Calcular(atributos)
    CD --> IB : int dvh
    IB -> IND : ActualizarDVHUsuario(id, dvh)
    IND -> DB : USUARIO_ACTUALIZAR_DVH(@id, @dvh)
  end
  loop por cada una de las 7 columnas (c = índice)
    IB -> CD : CalcularVertical(todasFilas, c)
    CD --> IB : int dvv
    IB -> IND : ActualizarDVV("USUARIO", columnas[c], dvv)
    IND -> DB : DVV_ACTUALIZAR(@tabla, @columna, @dvv)
  end
  IB --> UP : (DVH / DVV recalculados)
  deactivate IB
  note right of IB : PERFILES forma parte del DVH

  UP -> SM : getUsuario()
  SM --> UP : BE.USUARIO / null
  UP -> UP : admin = getUsuario()?.Usuario ?? "sistema"

  UP -> UH : RegistrarCambio(usuarioId, "ASIGNACION_PERFIL", admin)
  activate UH
  UH -> UD : ObtenerPorId(usuarioId)
  UD -> DB : USUARIO_OBTENER_POR_ID(@id)
  DB --> UD : fila de USUARIO
  UD --> UH : BE.USUARIO / null
  alt el usuario no existe (u == null)
    UH --> UP : return (no inserta nada)
  else el usuario existe
    UH -> UPD : ListarPerfilesPorUsuario(usuarioId)
    UPD -> DB : USUARIO_PERFIL_LISTAR(@usuario_id)
    DB --> UPD : PERFIL_ID
    UPD --> UH : List<int> perfiles
    UH -> UH : ordenar los ids y unirlos en CSV (Perfiles)
    UH -> UHD : Insertar(UsuarioHistorial)
    UHD -> DB : USUARIO_HISTORIAL_INSERTAR(@usuario_id, @usuario_login, @rol,\n@bloqueado, @intentos_fallidos, @perfiles, @nombre, @apellido,\n@telefono, @email, @realizado_por, @tipo_cambio = "ASIGNACION_PERFIL",\n@version_origen = null, @rol_id)
    UH --> UP : (cambio registrado)
  end
  deactivate UH

  UP -> SM : getUsuario()
  SM --> UP : usuarioSesion

  opt usuarioSesion != null y\nusuarioSesion.Id == usuarioId
    UP -> UD : ObtenerPorId(usuarioId)
    UD -> DB : USUARIO_OBTENER_POR_ID(@id)
    DB --> UD : fila de USUARIO
    UD --> UP : usuarioActualizado
    UP -> SM : setUsuario(usuarioActualizado)

    UP -> UPD : ListarPermisosDeUsuario(usuarioId)
    UPD -> DB : USUARIO_PERMISOS_LISTAR(@usuario_id)
    DB --> UPD : NOMBRE de cada permiso
    UPD --> UP : permisosActualizados
    UP -> SM : setPermisos(permisosActualizados)
    note right of SM
      Si el admin se reasigna
      perfiles a sí mismo, su
      sesión se refresca en
      caliente (USUARIO y
      permisos) para no forzar
      un relogueo.
    end note
  end
  UP --> FP : (asignaciones guardadas)
  deactivate UP

  FP --> A : "Asignaciones guardadas."\n(título "Éxito")
  note right of FP : el formulario NO se cierra tras guardar;\nse cierra con el botón "Cerrar"
end

note over FA, SM
  Al volver de frmAdminUsuarios, frmMenu ejecuta
  ActualizarVisibilidadMenu() (usa SessionManager.TienePermiso),
  por eso el menú refleja los permisos refrescados.
end note

@enduml
