@startuml DiagramaActividad_CuracionCajas

title Proceso de negocio — Curación, Armado y Despacho de Cajas Mensuales

skinparam shadowing false
skinparam roundcorner 6
' Los documentos de negocio se dibujan como nodos de objeto (rectángulo de esquinas rectas,
' fondo blanco) con flujos punteados de entrada y salida: estereotipo <<doc>>.
skinparam roundcorner<<doc>> 0
skinparam activity {
  BackgroundColor #FEFECE
  BorderColor #33342E
  BackgroundColor<<doc>> #FFFFFF
  BorderColor<<doc>> #33342E
}
skinparam partition {
  BorderColor #666666
  FontStyle bold
}
scale 0.8

|Atención al Socio|
start
:Relevar Preferencias del Socio;
:Registrar Perfil del Socio;
-[dashed]->
:**Ficha de Socio**
[Vigente]; <<doc>>
-[dashed]->
:Solicitar Caja del Período;
-[dashed]->
:**Solicitud de Caja**
[Pendiente]; <<doc>>
-[dashed]->

|Curador de Producto|
:Consultar Perfil de Preferencias del Socio;
:Consultar Catálogo Autorizado;
repeat
  :Seleccionar Vinos Compatibles;
backward: Reemplazar Vino por Alternativa más Económica;
repeat while (¿El total supera el presupuesto mensual?) is (sí) not (no)
:Confirmar Armado de la Caja;
-[dashed]->
:**Caja Mensual**
[Armada]; <<doc>>
-[dashed]->

|Encargado de Depósito|
:Preparar el Pedido de la Caja;
if (¿Hay faltante de stock en alguna línea?) then (sí)
  :Proponer Vino de Reemplazo;

  |Curador de Producto|
  repeat
    :Evaluar Compatibilidad del Reemplazo;
  backward: Rechazar Reemplazo y solicitar otra alternativa;
  repeat while (¿El reemplazo respeta perfil y presupuesto?) is (no) not (sí)
  :Aprobar el Vino de Reemplazo;

  |Encargado de Depósito|
  :Registrar la Sustitución;
  -[dashed]->
  :**Acta de Sustitución**
[Registrada]; <<doc>>
  -[dashed]->
else (no)
endif
:Embalar la Caja;
-[dashed]->
:**Caja Mensual**
[Preparada]; <<doc>>
-[dashed]->

|Logística|
:Despachar la Caja al Socio;
-[dashed]->
fork
  -[dashed]->
  :**Remito de Despacho**
[Emitido]; <<doc>>
  -[dashed]->
fork again
  -[dashed]->
  :**Caja Mensual**
[Despachada]; <<doc>>
  -[dashed]->
end fork
stop

@enduml
