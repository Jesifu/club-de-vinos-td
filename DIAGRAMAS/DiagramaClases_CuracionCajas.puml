@startuml DiagramaClases_CuracionCajas

title Diagrama de Clases — Curación y Armado de Cajas Mensuales

skinparam classAttributeIconSize 0
skinparam packageStyle rectangle
skinparam shadowing false
skinparam roundcorner 6
skinparam linetype ortho
hide empty members
scale 0.7

package "BE" #FEFECE {

  enum EstadoCaja {
    Armada
    Despachada
    Cancelada
  }

  class Socio {
    + Id : int
    + Nombre : string
    + Apellido : string
    + Email : string
    + Telefono : string
    + Domicilio : string
    + PresupuestoMensual : decimal
    + Activo : bool
    + FechaAlta : DateTime
    + CreadoPor : int
    + CreadoPorLogin : string
    + VarietalesPreferidos : List<string>
  }

  class CajaMensual {
    + Id : int
    + SocioId : int
    + SocioNombre : string
    + SocioDomicilio : string
    + SocioTelefono : string
    + Periodo : string
    + Estado : EstadoCaja
    + PresupuestoSnapshot : decimal
    + FechaArmado : DateTime
    + ArmadoPor : int
    + ArmadoPorLogin : string
    + FechaDespacho : DateTime?
    + DespachadoPor : int?
    + DespachadoPorLogin : string
    + FechaCancelacion : DateTime?
    + CanceladaPor : int?
    + MotivoCancelacion : string
    + Lineas : List<CajaVino>
  }

  class CajaVino {
    + Id : int
    + CajaId : int
    + VinoId : int
    + Cantidad : int
    + NombreSnapshot : string
    + PrecioSnapshot : decimal
    + VinoEfectivoId : int
    + NombreEfectivo : string
    + PrecioEfectivo : decimal
    + Sustituido : bool
    + StockDisponible : int
  }

  class Sustitucion {
    + Id : int
    + CajaVinoId : int
    + VinoOriginalId : int
    + VinoReemplazoId : int
    + NombreSnapshot : string
    + PrecioSnapshot : decimal
    + Motivo : string
    + ResponsableId : int
    + ResponsableLogin : string
    + Fecha : DateTime
  }

  class VinoCandidato {
    + Id : int
    + Codigo : string
    + Nombre : string
    + BodegaNombre : string
    + Varietal : string
    + Aniada : int
    + Precio : decimal
    + Stock : int
    + Preferido : bool
  }

  Socio        "1" o-- "0..*" CajaMensual : SocioId >
  CajaMensual  "1" o-- "0..*" CajaVino    : CajaId >
  CajaVino     "1" o-- "0..*" Sustitucion : CajaVinoId >
  CajaMensual  --> EstadoCaja
}

' ─────────────────────────────────────────
' CAPA DAL
' ─────────────────────────────────────────
package "DAL" #E8E8F4 {

  class Acceso <<existente>> {
    + Abrir() : void
    + Cerrar() : void
    + IniciarTx() : void
    + ConfirmarTX() : void
    + DeshacerTX() : void
    + Leer(sql : string, parametros : List<SqlParameter>) : DataTable
    + Escribir(sql : string, parametros : List<SqlParameter>) : int
  }

  class SocioDAL {
    - _acceso : Acceso
    + Insertar(s : Socio) : int
    + Actualizar(s : Socio) : void
    + ObtenerPorId(id : int) : Socio
    + ListarActivos() : List<Socio>
    + ListarVarietalesDeCatalogo() : List<string>
  }

  class CajaMensualDAL {
    - _acceso : Acceso
    + Armar(caja : CajaMensual) : int
    + ObtenerPorId(id : int) : CajaMensual
    + ListarComposicionEfectiva(cajaId : int) : List<CajaVino>
    + ListarPorEstado(estado : string) : List<CajaMensual>
    + Despachar(cajaId : int, despachadoPor : int, responsableLogin : string) : int
    + Cancelar(cajaId : int, motivo : string, canceladaPor : int) : int
  }

  class SustitucionDAL {
    - _acceso : Acceso
    + Insertar(s : Sustitucion) : int
    + ListarPorCaja(cajaId : int) : List<Sustitucion>
  }

  class VinoDAL <<existente>> {
    + ListarCandidatos(socioId : int) : List<VinoCandidato>
  }

  class BitacoraDAL <<existente>> {
    + Registrar(usuario : string, accion : string) : void
  }

  SocioDAL       --> Acceso
  CajaMensualDAL --> Acceso
  SustitucionDAL --> Acceso
  VinoDAL        --> Acceso
  BitacoraDAL    --> Acceso
}

' ─────────────────────────────────────────
' CAPA BLL
' ─────────────────────────────────────────
package "BLL" #E8F4E8 {

  class BitacoraBLL <<existente>> {
    - _dal : BitacoraDAL
    + RegistrarAccion(usuario : string, accion : string) : void
  }

  class SocioBLL {
    - _dal : SocioDAL
    - _bitacora : BitacoraBLL
    + ListarActivos() : List<Socio>
    + ObtenerPorId(id : int) : Socio
    + ListarVarietalesDeCatalogo() : List<string>
    + Registrar(s : Socio, sesion : USUARIO) : void
    + Actualizar(s : Socio, sesion : USUARIO) : void
  }

  class CajaMensualBLL {
    - _dal : CajaMensualDAL
    - _socioDal : SocioDAL
    - _vinoDal : VinoDAL
    - _sustitucionDal : SustitucionDAL
    - _bitacora : BitacoraBLL
    + ListarCandidatos(socioId : int) : List<VinoCandidato>
    + CalcularTotal(lineas : IEnumerable<CajaVino>) : decimal
    + ListarArmadas() : List<CajaMensual>
    + ListarDespachadas() : List<CajaMensual>
    + Armar(caja : CajaMensual, sesion : USUARIO) : int
    + ObtenerConComposicionEfectiva(cajaId : int) : CajaMensual
    + ListarTrazaSustituciones(cajaId : int) : List<Sustitucion>
    + RegistrarSustitucion(cajaId : int, cajaVinoId : int, vinoReemplazoId : int, motivo : string, sesion : USUARIO) : void
    + Despachar(cajaId : int, sesion : USUARIO) : void
    + Cancelar(cajaId : int, motivo : string, sesion : USUARIO) : void
  }

  SocioBLL       --> SocioDAL
  SocioBLL       --> BitacoraBLL
  BitacoraBLL    --> BitacoraDAL
  CajaMensualBLL --> CajaMensualDAL
  CajaMensualBLL --> SocioDAL
  CajaMensualBLL --> VinoDAL
  CajaMensualBLL --> SustitucionDAL
  CajaMensualBLL --> BitacoraBLL
}

' ─────────────────────────────────────────
' CAPA CAPAS (presentación)
' ─────────────────────────────────────────
package "CAPAS" #F4E8E8 {

  class frmSocios {
    + ActualizarIdioma() : void
  }
  class frmArmarCaja {
    + ActualizarIdioma() : void
  }
  class frmPickingCaja {
    + ActualizarIdioma() : void
  }
  class frmDespacharCaja {
    + ActualizarIdioma() : void
  }
  class frmHistorialDespachos {
    + ActualizarIdioma() : void
  }
  class RemitoDespachoPdf <<static>> {
    ~ Generar(caja : CajaMensual) : string
    ~ Abrir(rutaPdf : string) : void
  }

  frmSocios             --> SocioBLL
  frmArmarCaja          --> CajaMensualBLL
  frmArmarCaja          --> SocioBLL
  frmPickingCaja        --> CajaMensualBLL
  frmDespacharCaja      --> CajaMensualBLL
  frmDespacharCaja      --> RemitoDespachoPdf
  frmHistorialDespachos --> CajaMensualBLL
  frmHistorialDespachos --> RemitoDespachoPdf
}

@enduml
