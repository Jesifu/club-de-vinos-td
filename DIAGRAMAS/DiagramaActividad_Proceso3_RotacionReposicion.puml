@startuml DiagramaActividad_Proceso3_RotacionReposicion

title Proceso de negocio — Análisis de Rotación y Reposición de Stock

skinparam shadowing false
skinparam roundcorner 6
' Los documentos de negocio se dibujan como nodos de objeto (rectángulo de esquinas rectas,
' fondo blanco) con flujos punteados de entrada y salida: estereotipo <<doc>>.
skinparam roundcorner<<doc>> 0
skinparam activity {
  BackgroundColor #FEFECE
  BorderColor #33342E
  BackgroundColor<<doc>> #FFFFFF
  BorderColor<<doc>> #33342E
}
skinparam partition {
  BorderColor #666666
  FontStyle bold
}
scale 0.8

|Encargado de Compras/Bodega|
start
-[dashed]->
:**Movimientos de Stock y Cajas Despachadas**
[Registrados]; <<doc>>
note right
  Insumo de los procesos anteriores:
  stock y ajustes (Proceso 1, Catálogo y Stock)
  y despachos de cajas (Proceso 2, Curación
  y Cajas Mensuales).
end note
-[dashed]->
:Definir Parámetros de Rotación;
-[dashed]->
:**Configuración de Parámetros de Rotación**
[Vigente]; <<doc>>
-[dashed]->
:Analizar Rotación de Stock;
:Revisar Gráficos del Análisis;
:Exportar Informe de Rotación y Reposición;
-[dashed]->
:**Informe de Rotación y Reposición**
[Emitido]; <<doc>>
-[dashed]->
if (¿Hay vinos a reponer?) then (sí)
  :Generar Pedido de Reposición;
  -[dashed]->
  :**Pedido de Reposición**
[Pendiente]; <<doc>>
  -[dashed]->

  |Administrador|
  :Revisar Informe y Pedido de Reposición;
  if (¿Autoriza el pedido?) then (sí)
    :Autorizar Pedido de Reposición;
    -[dashed]->
    :**Pedido de Reposición**
[Aprobado]; <<doc>>
    -[dashed]->

    |Encargado de Depósito|
    :Recibir Mercadería del Pedido;
    :Registrar Recepción del Pedido;
    -[dashed]->
    :**Pedido de Reposición**
[Recibido]; <<doc>>
    -[dashed]->
    :**Movimiento de Stock**
[Entrada registrada]; <<doc>>
    note right
      El siguiente análisis ya ve el stock
      repuesto y deja de contar lo recibido
      como "en camino".
    end note
  else (no)
    |Administrador|
    :Rechazar Pedido de Reposición;
    -[dashed]->
    :**Pedido de Reposición**
[Rechazado]; <<doc>>
    note right
      Rechazo con motivo (1 a 200 caracteres).
      Los vinos del pedido quedan libres:
      el próximo análisis puede volver a sugerirlos.
    end note
  endif
else (no)
endif
stop

@enduml
