@startuml DiagramaClases_CatalogoStock

title Diagrama de Clases — Gestión de Catálogo y Stock de Vinos

skinparam classAttributeIconSize 0
skinparam packageStyle rectangle
skinparam shadowing false
skinparam roundcorner 6
skinparam linetype ortho
hide empty members
scale 0.6

' Implementado: CU-21 a CU-27 (alta y baja con Solicitud de Autorización).

package "BE" #FEFECE {

  enum EstadoVino {
    Activo
    Descontinuado
    Pendiente
    Rechazado
  }

  enum TipoSolicitud {
    Alta
    Baja
  }

  enum EstadoSolicitud {
    Pendiente
    Aprobada
    Rechazada
  }

  enum TipoMovimiento {
    Entrada
    Salida
  }

  class Vino {
    + Id : int
    + Codigo : string
    + Nombre : string
    + BodegaId : int
    + BodegaNombre : string
    + Varietal : string
    + Aniada : int
    + Precio : decimal
    + StockMinimo : int
    + Estado : EstadoVino
    + Maridaje : string
    + Puntaje : int?
    + CreadoPor : int
    + CreadoPorLogin : string
    + FechaAlta : DateTime
    .. última solicitud (solo ListarCatalogo) ..
    + UltimaSolicitudTipo : TipoSolicitud?
    + UltimaSolicitudEstado : EstadoSolicitud?
    + UltimoMotivoRechazo : string
  }

  class SolicitudAutorizacion {
    + Id : int
    + Tipo : TipoSolicitud
    + VinoId : int
    + VinoCodigo : string
    + VinoNombre : string
    + BodegaNombre : string
    + Estado : EstadoSolicitud
    + EmisorId : int
    + EmisorLogin : string
    + FechaEmision : DateTime
    + ResolutorId : int?
    + ResolutorLogin : string
    + FechaResolucion : DateTime?
    + MotivoRechazo : string
    + StockActual : int
    + Vino : Vino
  }

  class AlertaStockMinimo {
    + VinoId : int
    + Codigo : string
    + Nombre : string
    + BodegaNombre : string
    + StockMinimo : int
    + StockActual : int
    + Faltante : int
  }

  class Bodega {
    + Id : int
    + Nombre : string
    + Pais : string
    + Region : string
    + Habilitado : bool
    + ToString() : string
  }

  class MovimientoStock {
    + Id : int
    + VinoId : int
    + VinoNombre : string
    + Fecha : DateTime
    + Tipo : TipoMovimiento
    + Cantidad : int
    + Motivo : string
    + Responsable : string
    + ReferenciaTipo : string
    + ReferenciaId : int?
  }

  class VinoCandidato <<existente>> {
    + Id : int
    + Codigo : string
    + Nombre : string
    + BodegaNombre : string
    + Varietal : string
    + Aniada : int
    + Precio : decimal
    + Stock : int
    + Preferido : bool
    + ToString() : string
  }

  class USUARIO <<existente>> {
    + Id : int
    + Usuario : string
  }

  Vino                 "0..*" --> "1" Bodega : BodegaId >
  MovimientoStock      "0..*" --> "1" Vino : VinoId >
  SolicitudAutorizacion "0..*" --> "1" Vino : Vino >
  Vino                 --> EstadoVino
  Vino                 --> TipoSolicitud
  Vino                 --> EstadoSolicitud
  SolicitudAutorizacion --> TipoSolicitud
  SolicitudAutorizacion --> EstadoSolicitud
  MovimientoStock      --> TipoMovimiento
}

' ─────────────────────────────────────────
' CAPA DAL
' ─────────────────────────────────────────
package "DAL" #E8E8F4 {

  class Acceso <<existente>> {
    + Abrir() : void
    + Cerrar() : void
    + Leer(sql : string, parametros : List<SqlParameter> = null) : DataTable
    + Escribir(sql : string, parametros : List<SqlParameter> = null) : int
    + CrearParametro(nombre : string, valor : string) : SqlParameter
    + CrearParametro(nombre : string, valor : int) : SqlParameter
  }

  class VinoDAL {
    - _acceso : Acceso
    .. CU-21 ..
    + Insertar(v : Vino) : void
    + Reproponer(v : Vino, emisorId : int) : int
    + ObtenerPorCodigo(codigo : string) : Vino
    .. CU-21, CU-24, CU-23 y CU-27 ..
    + ObtenerPorId(id : int) : Vino
    .. CU-21 y CU-24 ..
    + ListarCatalogo(usuarioId : int) : List<Vino>
    .. CU-23 y CU-27 ..
    + ListarAutorizados() : List<Vino>
    .. usado por CajaMensualBLL (CU-28 y CU-29) ..
    + ListarCandidatos(socioId : int) : List<VinoCandidato>
    .. CU-24 ..
    + SolicitarBaja(vinoId : int, solicitanteId : int) : int
    .. CU-26 ..
    + ListarBajoStockMinimo() : List<AlertaStockMinimo>
  }

  class SolicitudAutorizacionDAL {
    - _acceso : Acceso
    + ListarPendientes(tipo : TipoSolicitud) : List<SolicitudAutorizacion>
    + ObtenerPorId(id : int) : SolicitudAutorizacion
    + ObtenerPendiente(vinoId : int, tipo : TipoSolicitud) : SolicitudAutorizacion
    ~ {static} TipoDesdeDb(valor : string) : TipoSolicitud
    .. CU-22 ..
    + AprobarAlta(solicitudId : int, resolutorId : int) : int
    + RechazarAlta(solicitudId : int, resolutorId : int, motivo : string) : int
    .. CU-25 ..
    + AprobarBaja(solicitudId : int, resolutorId : int) : int
    + RechazarBaja(solicitudId : int, resolutorId : int, motivo : string) : int
  }

  class BodegaDAL {
    - _acceso : Acceso
    + ListarHabilitadas() : List<Bodega>
  }

  class MovimientoStockDAL {
    - _acceso : Acceso
    + Insertar(m : MovimientoStock) : void
    + InsertarSalida(m : MovimientoStock) : int
    + ListarPorVino(vinoId : int) : List<MovimientoStock>
    + ObtenerStockActual(vinoId : int) : int
  }

  class BitacoraDAL <<existente>> {
    - _acceso : Acceso
    + Registrar(usuario : string, accion : string) : void
  }

  VinoDAL                  --> Acceso
  VinoDAL                  ..> VinoCandidato
  VinoDAL                  ..> SolicitudAutorizacionDAL : TipoDesdeDb >
  SolicitudAutorizacionDAL --> Acceso
  BodegaDAL          --> Acceso
  MovimientoStockDAL --> Acceso
  BitacoraDAL        --> Acceso
}

' ─────────────────────────────────────────
' CAPA BLL
' ─────────────────────────────────────────
package "BLL" #E8F4E8 {

  class BitacoraBLL <<existente>> {
    - _dal : BitacoraDAL
    + RegistrarAccion(usuario : string, accion : string) : void
  }

  class VinoBLL {
    - _dal : VinoDAL
    - _solicitudDal : SolicitudAutorizacionDAL
    - _bodegaDal : BodegaDAL
    - _movimientoDal : MovimientoStockDAL
    - _bitacora : BitacoraBLL
    + ListarBodegas() : List<Bodega>
    .. CU-21 ..
    + ProponerAlta(v : Vino, sesion : USUARIO) : void
    + Reproponer(v : Vino, sesion : USUARIO) : void
    .. CU-21 y CU-24 ..
    + ListarCatalogo(sesion : USUARIO) : List<Vino>
    .. CU-23 y CU-27 ..
    + ListarAutorizados() : List<Vino>
    .. CU-22 ..
    + ListarSolicitudesPendientes(tipo : TipoSolicitud) : List<SolicitudAutorizacion>
    + AutorizarAlta(solicitudId : int, sesion : USUARIO) : void
    + RechazarAlta(solicitudId : int, motivo : string, sesion : USUARIO) : void
    .. CU-24 y CU-25 ..
    + SolicitarBaja(vinoId : int, sesion : USUARIO) : void
    + AutorizarBaja(solicitudId : int, sesion : USUARIO) : void
    + RechazarBaja(solicitudId : int, motivo : string, sesion : USUARIO) : void
    .. auxiliares privados ..
    - ValidarDatos(v : Vino, exigirCodigo : bool) : void
    - ObtenerSolicitudPendiente(solicitudId : int, tipo : TipoSolicitud) : SolicitudAutorizacion
    - ValidarSeparacionDeFunciones(s : SolicitudAutorizacion, sesion : USUARIO, accion : string) : void
    - ValidarMotivo(motivo : string) : string
    - ValidarSinStock(vinoId : int) : void
    .. CU-26 ..
    + ListarAlertaStockMinimo() : List<AlertaStockMinimo>
  }

  class MovimientoStockBLL {
    - _dal : MovimientoStockDAL
    - _vinoDal : VinoDAL
    - _bitacora : BitacoraBLL
    + {static} ReferenciaAjuste : string = "AJUSTE"
    + RegistrarEntrada(m : MovimientoStock, sesion : USUARIO) : void
    + ObtenerStockActual(vinoId : int) : int
    + ObtenerMovimientos(vinoId : int) : List<MovimientoStock>
    .. CU-27 (ajuste negativo) ..
    + RegistrarSalida(m : MovimientoStock, sesion : USUARIO) : void
  }

  VinoBLL            --> VinoDAL
  VinoBLL            --> SolicitudAutorizacionDAL
  VinoBLL            --> BodegaDAL
  VinoBLL            --> MovimientoStockDAL
  VinoBLL            --> BitacoraBLL
  MovimientoStockBLL --> MovimientoStockDAL
  MovimientoStockBLL --> VinoDAL
  MovimientoStockBLL --> BitacoraBLL
  BitacoraBLL        --> BitacoraDAL
}

' ─────────────────────────────────────────
' CAPA SeguridadYServicios
' ─────────────────────────────────────────
package "SeguridadYServicios" #D5E8D4 {

  interface IObservadorIdioma <<existente>> {
    + ActualizarIdioma() : void
  }
}

' ─────────────────────────────────────────
' CAPA CAPAS (presentación)
' ─────────────────────────────────────────
package "CAPAS" #F4E8E8 {

  class FormBase <<existente>> {
  }
  note right of FormBase : Hereda de ReaLTaiizor.Forms.MaterialForm

  class frmCatalogoVinos {
    - _bll : VinoBLL
    + ActualizarIdioma() : void
    - btnGuardarVino_Click(sender : object, e : EventArgs) : void
    - CargarVinos() : void
    - dgvVinos_SelectionChanged(sender : object, e : EventArgs) : void
    - ActualizarEstadoBajaBoton() : void
    - btnReproponer_Click(sender : object, e : EventArgs) : void
    - btnSolicitarBaja_Click(sender : object, e : EventArgs) : void
  }

  class frmAutorizarAltaVino {
    - _bll : VinoBLL
    + ActualizarIdioma() : void
    - MostrarDetalle() : void
    - btnAutorizar_Click(sender : object, e : EventArgs) : void
    - btnRechazarAlta_Click(sender : object, e : EventArgs) : void
  }

  class frmRegistrarEntradaStock {
    - _bll : MovimientoStockBLL
    - _vinoBll : VinoBLL
    + ActualizarIdioma() : void
    - btnRegistrarEntrada_Click(sender : object, e : EventArgs) : void
  }

  class frmAutorizarBajaVino {
    - _bll : VinoBLL
    + ActualizarIdioma() : void
    - MostrarDetalle() : void
    - btnAutorizarBaja_Click(sender : object, e : EventArgs) : void
    - btnRechazarBaja_Click(sender : object, e : EventArgs) : void
  }

  class frmAlertaStockMinimo {
    - _bll : VinoBLL
    + ActualizarIdioma() : void
  }

  class frmRegistrarAjusteInventario {
    - _bll : MovimientoStockBLL
    - _vinoBll : VinoBLL
    + ActualizarIdioma() : void
    - btnRegistrarAjuste_Click(sender : object, e : EventArgs) : void
  }

  FormBase <|-- frmCatalogoVinos
  FormBase <|-- frmAutorizarAltaVino
  FormBase <|-- frmRegistrarEntradaStock
  FormBase <|-- frmAutorizarBajaVino
  FormBase <|-- frmAlertaStockMinimo
  FormBase <|-- frmRegistrarAjusteInventario

  IObservadorIdioma <|.. frmCatalogoVinos
  IObservadorIdioma <|.. frmAutorizarAltaVino
  IObservadorIdioma <|.. frmRegistrarEntradaStock
  IObservadorIdioma <|.. frmAutorizarBajaVino
  IObservadorIdioma <|.. frmAlertaStockMinimo
  IObservadorIdioma <|.. frmRegistrarAjusteInventario

  frmCatalogoVinos            --> VinoBLL
  frmAutorizarAltaVino        --> VinoBLL
  frmRegistrarEntradaStock    --> MovimientoStockBLL
  frmRegistrarEntradaStock    --> VinoBLL
  frmAutorizarBajaVino        --> VinoBLL
  frmAlertaStockMinimo        --> VinoBLL
  frmRegistrarAjusteInventario --> MovimientoStockBLL
  frmRegistrarAjusteInventario --> VinoBLL
}

@enduml
