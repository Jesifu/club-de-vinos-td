@startuml DiagramaClases_CatalogoStock

title Diagrama de Clases — Gestión de Catálogo y Stock de Vinos

skinparam classAttributeIconSize 0
skinparam packageStyle rectangle
skinparam shadowing false
skinparam roundcorner 6
skinparam linetype ortho
hide empty members
scale 0.6

' Implementado: CU-21, CU-22 y CU-23.
' Diseño pendiente (marcado «no implementado»): CU-24, CU-25 y CU-27.

package "BE" #FEFECE {

  enum EstadoVino {
    Activo
    Descontinuado
  }

  enum TipoMovimiento {
    Entrada
    Salida
  }

  class Vino {
    + Id : int
    + Codigo : string
    + Nombre : string
    + BodegaId : int
    + BodegaNombre : string
    + Varietal : string
    + Aniada : int
    + Precio : decimal
    + StockMinimo : int
    + Estado : EstadoVino
    + Maridaje : string
    + Puntaje : int?
    + CreadoPor : int
    + CreadoPorLogin : string
    + FechaAlta : DateTime
    + AutorizadoPor : int?
    + AutorizadoPorLogin : string
    + FechaAutorizacion : DateTime?
  }

  class Bodega {
    + Id : int
    + Nombre : string
    + Pais : string
    + Region : string
    + Habilitado : bool
    + ToString() : string
  }

  class MovimientoStock {
    + Id : int
    + VinoId : int
    + VinoNombre : string
    + Fecha : DateTime
    + Tipo : TipoMovimiento
    + Cantidad : int
    + Motivo : string
    + Responsable : string
    + ReferenciaTipo : string
    + ReferenciaId : int?
  }

  class USUARIO <<existente>> {
    + Id : int
    + Usuario : string
  }

  Bodega "1" o-- "0..*" Vino            : BodegaId >
  Vino   "1" o-- "0..*" MovimientoStock : VinoId >
  Vino            --> EstadoVino
  MovimientoStock --> TipoMovimiento

  note bottom of Vino
    La tabla VINO ya tiene las columnas de baja
    (BAJA_SOLICITADA_POR, FECHA_SOLICITUD_BAJA,
    DESCONTINUADO_POR, FECHA_DESCONTINUACION),
    pero BE.Vino todavía no las mapea: se agregarán
    al implementar CU-24 y CU-25.
  end note
}

' ─────────────────────────────────────────
' CAPA DAL
' ─────────────────────────────────────────
package "DAL" #E8E8F4 {

  class Acceso <<existente>> {
    + Abrir() : void
    + Cerrar() : void
    + Leer(sql : string, parametros : List<SqlParameter>) : DataTable
    + Escribir(sql : string, parametros : List<SqlParameter>) : int
    + CrearParametro(nombre : string, valor : string) : SqlParameter
    + CrearParametro(nombre : string, valor : int) : SqlParameter
  }

  class VinoDAL {
    - _acceso : Acceso
    + Insertar(v : Vino) : void
    + ObtenerPorCodigo(codigo : string) : Vino
    + ObtenerPorId(id : int) : Vino
    + ListarPendientes() : List<Vino>
    + ListarAutorizados() : List<Vino>
    + Autorizar(vinoId : int, adminId : int) : int
    .. usado por CajaMensualBLL (CU-28) ..
    + ListarCandidatos(socioId : int) : List<VinoCandidato>
    .. «no implementado» (CU-24 y CU-25) ..
    + SolicitarBaja(vinoId : int, solicitanteId : int) : int
    + ListarPendientesDeBaja() : List<Vino>
    + AutorizarBaja(vinoId : int, adminId : int) : int
  }

  class BodegaDAL {
    - _acceso : Acceso
    + ListarHabilitadas() : List<Bodega>
  }

  class MovimientoStockDAL {
    - _acceso : Acceso
    + Insertar(m : MovimientoStock) : void
    + ListarPorVino(vinoId : int) : List<MovimientoStock>
    + ObtenerStockActual(vinoId : int) : int
  }

  class BitacoraDAL <<existente>> {
    - _acceso : Acceso
    + Registrar(usuario : string, accion : string) : void
  }

  VinoDAL            --> Acceso
  BodegaDAL          --> Acceso
  MovimientoStockDAL --> Acceso
  BitacoraDAL        --> Acceso
}

' ─────────────────────────────────────────
' CAPA BLL
' ─────────────────────────────────────────
package "BLL" #E8F4E8 {

  class BitacoraBLL <<existente>> {
    - _dal : BitacoraDAL
    + RegistrarAccion(usuario : string, accion : string) : void
  }

  class VinoBLL {
    - _dal : VinoDAL
    - _bodegaDal : BodegaDAL
    - _bitacora : BitacoraBLL
    + ListarBodegas() : List<Bodega>
    + ProponerAlta(v : Vino, sesion : USUARIO) : void
    + ListarPendientes() : List<Vino>
    + ListarAutorizados() : List<Vino>
    + Autorizar(vinoId : int, sesion : USUARIO) : void
    .. «no implementado» (CU-24 y CU-25) ..
    + SolicitarBaja(vinoId : int, sesion : USUARIO) : void
    + ListarPendientesDeBaja() : List<Vino>
    + AutorizarBaja(vinoId : int, sesion : USUARIO) : void
  }

  class MovimientoStockBLL {
    - _dal : MovimientoStockDAL
    - _vinoDal : VinoDAL
    - _bitacora : BitacoraBLL
    + RegistrarEntrada(m : MovimientoStock, sesion : USUARIO) : void
    + ObtenerStockActual(vinoId : int) : int
    + ObtenerMovimientos(vinoId : int) : List<MovimientoStock>
    .. «no implementado» (CU-27) ..
    + RegistrarSalida(m : MovimientoStock, sesion : USUARIO) : void
  }

  VinoBLL            --> VinoDAL
  VinoBLL            --> BodegaDAL
  VinoBLL            --> BitacoraBLL
  MovimientoStockBLL --> MovimientoStockDAL
  MovimientoStockBLL --> VinoDAL
  MovimientoStockBLL --> BitacoraBLL
  BitacoraBLL        --> BitacoraDAL
}

' ─────────────────────────────────────────
' CAPA CAPAS (presentación)
' ─────────────────────────────────────────
package "CAPAS" #F4E8E8 {

  class FormBase <<existente>> {
  }

  interface IObservadorIdioma <<existente>> {
    + ActualizarIdioma() : void
  }

  class frmCatalogoVinos {
    - _bll : VinoBLL
    + ActualizarIdioma() : void
    - btnGuardarVino_Click() : void
    .. «no implementado» (CU-24) ..
    - btnSolicitarBaja_Click() : void
  }

  class frmAutorizarAltaVino {
    - _bll : VinoBLL
    + ActualizarIdioma() : void
    - btnAutorizar_Click() : void
  }

  class frmRegistrarEntradaStock {
    - _bll : MovimientoStockBLL
    - _vinoBll : VinoBLL
    + ActualizarIdioma() : void
    - btnRegistrarEntrada_Click() : void
  }

  class frmAutorizarBajaVino <<no implementado>> {
    - _bll : VinoBLL
    + ActualizarIdioma() : void
    - btnAutorizarBaja_Click() : void
  }

  class frmRegistrarAjusteInventario <<no implementado>> {
    - _bll : MovimientoStockBLL
    - _vinoBll : VinoBLL
    + ActualizarIdioma() : void
    - btnRegistrarAjuste_Click() : void
  }

  FormBase <|-- frmCatalogoVinos
  FormBase <|-- frmAutorizarAltaVino
  FormBase <|-- frmRegistrarEntradaStock
  FormBase <|-- frmAutorizarBajaVino
  FormBase <|-- frmRegistrarAjusteInventario

  IObservadorIdioma <|.. frmCatalogoVinos
  IObservadorIdioma <|.. frmAutorizarAltaVino
  IObservadorIdioma <|.. frmRegistrarEntradaStock
  IObservadorIdioma <|.. frmAutorizarBajaVino
  IObservadorIdioma <|.. frmRegistrarAjusteInventario

  frmCatalogoVinos            --> VinoBLL
  frmAutorizarAltaVino        --> VinoBLL
  frmRegistrarEntradaStock    --> MovimientoStockBLL
  frmRegistrarEntradaStock    --> VinoBLL
  frmAutorizarBajaVino        --> VinoBLL
  frmRegistrarAjusteInventario --> MovimientoStockBLL
  frmRegistrarAjusteInventario --> VinoBLL
}

@enduml
