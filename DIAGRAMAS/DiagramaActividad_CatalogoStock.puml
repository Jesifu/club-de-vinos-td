@startuml DiagramaActividad_CatalogoStock

title Proceso de negocio — Ingreso de Mercadería, Ajuste de Inventario y Actualización de Legajos

skinparam shadowing false
skinparam roundcorner 6
' Los documentos de negocio se dibujan como nodos de objeto (rectángulo de esquinas rectas,
' fondo blanco) con flujos punteados de entrada y salida: estereotipo <<doc>>.
skinparam roundcorner<<doc>> 0
skinparam activity {
  BackgroundColor #FEFECE
  BorderColor #33342E
  BackgroundColor<<doc>> #FFFFFF
  BorderColor<<doc>> #33342E
}
skinparam partition {
  BorderColor #666666
  FontStyle bold
}
scale 0.8

|Bodega/Proveedor|
start
repeat
  :Despachar Mercadería;
  -[dashed]->
  :**Remito**
[Emitido]; <<doc>>
  -[dashed]->

  |Encargado de Depósito|
  :Recepcionar Mercadería;
  :Consultar a Compras por la
Orden de Compra asociada al Remito;

  |Encargado de Compras|
  :Verificar Orden de Compra;
  if (¿Existe Orden de Compra que
respalde el Remito?) then (no)
    :Informar Remito sin respaldo
y solicitar reenvío;
    -[dashed]->
    :**Remito**
[Rechazado]; <<doc>>
    -[dashed]->
  else (sí)
    -[dashed]->
    :**Orden de Compra**
[Verificada]; <<doc>>
    -[dashed]->
  endif
repeat while (¿Se rechazó el Remito?) is (sí) not (no)

:Confirmar Vinculación Remito–OC;
-[dashed]->
:**Remito**
[Conciliado]; <<doc>>
-[dashed]->

|Encargado de Depósito|
:Registrar Ingreso de Stock;
:Validar Stock Mínimo;

if (¿Se detectó una diferencia de
inventario (rotura, merma, error
de conteo)?) then (sí)
  :Registrar Ajuste de Inventario;
  -[dashed]->
  :**Acta de Ajuste de Inventario**
[Registrada]; <<doc>>
  -[dashed]->
else (no)
endif

|Encargado de Compras|
:Actualizar Legajo de Bodega;

if (¿El vino recibido es nuevo
en el catálogo?) then (sí)
  repeat
    :Proponer Alta de Vino;
    -[dashed]->
    :**Solicitud de Autorización**
[Pendiente]; <<doc>>
    -[dashed]->

    |Administrador|
    :Evaluar Propuesta de Alta;
    if (¿Se aprueba la propuesta?) then (no)
      :Rechazar Propuesta de Alta
con motivo;
      -[dashed]->
      :**Solicitud de Autorización**
[Rechazada]; <<doc>>
      -[dashed]->

      |Encargado de Compras|
      :Revisar Propuesta Rechazada;
    else (sí)
    endif
  repeat while (¿Se rechazó la propuesta?) is (sí) not (no)

  |Administrador|
  :Autorizar Publicación de Vino;
  -[dashed]->
  :**Solicitud de Autorización**
[Aprobada]; <<doc>>
  -[dashed]->

  |Encargado de Compras|
else (no)
endif

if (¿Corresponde retirar algún vino
del catálogo?) then (sí)
  repeat
    :Solicitar Descontinuación de Vino;
    -[dashed]->
    :**Solicitud de Autorización**
[Pendiente]; <<doc>>
    -[dashed]->

    |Administrador|
    :Evaluar Solicitud de Descontinuación;
    if (¿Se aprueba la solicitud?) then (no)
      :Rechazar Solicitud de Descontinuación
con motivo;
      -[dashed]->
      :**Solicitud de Autorización**
[Rechazada]; <<doc>>
      -[dashed]->

      |Encargado de Compras|
      :Revisar Solicitud Rechazada;
    else (sí)
    endif
  repeat while (¿Se rechazó la solicitud?) is (sí) not (no)

  |Administrador|
  :Autorizar Descontinuación de Vino;
  -[dashed]->
  :**Solicitud de Autorización**
[Aprobada]; <<doc>>
  -[dashed]->

  |Encargado de Compras|
else (no)
endif

stop

@enduml
