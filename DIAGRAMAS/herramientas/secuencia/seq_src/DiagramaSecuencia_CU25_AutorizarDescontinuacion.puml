@startuml DiagramaSecuencia_CU25_AutorizarDescontinuacion

title CU-25 — Autorizar o Rechazar Descontinuación de Vino — Diagrama de Secuencia

skinparam shadowing false
skinparam roundcorner 6
skinparam sequenceArrowThickness 1.2
skinparam sequenceMessageAlign center
hide footbox
scale 0.6

actor       ":Administrador"           as A
participant ":frmAutorizarBajaVino"    as FA #FEFECE
participant ":VinoBLL"                 as VB #E8F4E8
participant ":BitacoraBLL"             as BB #E8F4E8
participant ":SolicitudAutorizacionDAL" as SD #E8E8F4
participant ":MovimientoStockDAL"      as MD #E8E8F4
participant ":BitacoraDAL"             as TD #E8E8F4
database    ":DB"                      as DB #EEEEEE

note over FA
  Precondición: sesión activa; permiso "Autorizar alta de vinos";
  existe al menos una solicitud de baja Pendiente.
  sesion = SessionManager.getInstance().getUsuario().
end note

A -> FA : menú Catálogo > "Autorizar descontinuación de vinos"\n(new frmAutorizarBajaVino().ShowDialog())
activate FA
note right of FA
  Load: se registra en IdiomaManager, traduce sus controles,
  CargarPendientes() y agrega el selector de idiomas.
  DataBindingComplete de la grilla y Shown del formulario
  también reevalúan ActualizarSeleccion().
end note
@LP Baja
FA --> A : grilla de solicitudes de baja pendientes

A -> FA : seleccionar una solicitud
FA -> FA : dgvPendientesBaja_SelectionChanged → ActualizarSeleccion()
FA -> FA : MostrarDetalle(): cargar en el panel de detalle los datos de la\nsolicitud y del vino, incluido el stock actual
FA -> FA : ActualizarEstadoBotones(): habilitar "Autorizar baja" y "Rechazar baja"\nsolo si solicitud.EmisorId <> sesion.Id (RN-01, capa UI)

opt 25a. la solicitud la emitió el propio administrador (EmisorId == sesion.Id)
  FA -> FA : btnAutorizarBaja y btnRechazarBaja quedan deshabilitados
  note right of FA : RN-01: BLL y SP también rechazan la resolución\nde una solicitud propia
end

alt el administrador autoriza la baja ("Autorizar baja")
  A -> FA : click "Autorizar baja"

  break 25f. no hay solicitud seleccionada
    FA --> A : "Seleccioná un vino con baja solicitada."\n(título "Atención")
    note right of FA : return: no recarga la grilla
  end

  FA --> A : solicitar confirmación\n("¿Autorizar la descontinuación del vino 'X'? El vino dejará de estar\ndisponible.") (título "Confirmar")

  break 25g. el administrador responde "No"
    A --> FA : No
    note right of FA : return: no llama a la BLL ni recarga la grilla
  end

  A --> FA : Sí
  FA -> VB : AutorizarBaja(solicitud.Id, sesion)
  VB -> VB : ObtenerSolicitudPendiente(solicitudId, TipoSolicitud.Baja)
  VB -> SD : ObtenerPorId(solicitudId)
  SD -> DB : SOLICITUD_OBTENER_POR_ID(@id)
  DB --> SD : filas
  SD --> VB : SolicitudAutorizacion (o null)

  alt 25e. la solicitud no existe, ya fue resuelta o no es de baja
    VB --> FA : throw InvalidOperationException\n("La solicitud indicada no existe." / "La solicitud ya fue resuelta." /\n"La solicitud no corresponde a este trámite.")
  else solicitud pendiente de baja
    VB -> VB : ValidarSeparacionDeFunciones(s, sesion, "autorizar")

    alt 25a. el administrador es quien emitió la solicitud (RN-01, capa BLL)
      VB --> FA : throw InvalidOperationException\n("No puede autorizar una solicitud que usted mismo emitió.")
    else el administrador no es el emisor
      VB -> VB : ValidarSinStock(s.VinoId)
      VB -> MD : ObtenerStockActual(vinoId)
      MD -> DB : STOCK_ACTUAL_OBTENER(@vino_id)
      DB --> MD : STOCK
      MD --> VB : int

      alt 25d. el vino tiene stock distinto de 0 (RN-15, revalidación)
        VB --> FA : throw InvalidOperationException\n("No se puede descontinuar un vino con stock (N botellas). Registre un\najuste de inventario para dejarlo en 0 y luego solicite la baja.")
      else stock = 0
        VB -> SD : AprobarBaja(s.Id, sesion.Id)
        SD -> DB : SOLICITUD_APROBAR_BAJA(@solicitud_id,@resolutor_id)
        note right of DB : en una transacción: solicitud Aprobada (WHERE EMISOR_ID <> @resolutor_id)\n+ VINO Activo → Descontinuado (RN-04), con la revalidación de RN-15\ncon UPDLOCK/HOLDLOCK
        DB --> SD : FILAS
        SD --> VB : int filas

        alt 25e. 0 filas (RN-01 y RN-15, backstop SP)
          VB --> FA : throw InvalidOperationException\n("No se pudo autorizar la baja: el vino cambió de estado o de stock.\nActualice e intente nuevamente.")
        else 1 fila
          VB -> BB : RegistrarAccion(sesion.Usuario,\n"AUTORIZACION_BAJA_VINO:" + s.VinoCodigo)
          BB -> TD : Registrar(usuario, accion)
          TD -> DB : BITACORA_INSERTAR(@usuario,@accion)
          DB --> TD : filas afectadas
          TD --> BB : void
          BB --> VB : void
          VB --> FA : void
          FA --> A : "Vino descontinuado correctamente."\n(título "Éxito")
          FA -> FA : txtMotivoRechazo.Clear()
          @LP Baja
        end
      end
    end
  end

  opt la BLL lanzó InvalidOperationException (catch de btnAutorizarBaja_Click)
    FA --> A : ex.Message\n(título "Atención")
    @LP Baja
    note right of FA : return
  end

else 25b. el administrador rechaza la baja con motivo ("Rechazar baja")
  A -> FA : escribir el motivo + click "Rechazar baja"

  break 25f. no hay solicitud seleccionada
    FA --> A : "Seleccioná un vino con baja solicitada."\n(título "Atención")
    note right of FA : return: no recarga la grilla
  end

  FA -> FA : motivo = txtMotivoRechazo.Text.Trim()

  break 25c. motivo vacío (UI)
    FA --> A : "Debe indicar el motivo del rechazo."\n(título "Atención")
    FA -> FA : txtMotivoRechazo.Focus()
    note right of FA : return: no recarga la grilla
  end

  FA --> A : solicitar confirmación\n("¿Rechazar la descontinuación del vino 'X'? El vino seguirá activo.")\n(título "Confirmar")

  break 25g. el administrador responde "No"
    A --> FA : No
    note right of FA : return: no llama a la BLL ni recarga la grilla
  end

  A --> FA : Sí
  FA -> VB : RechazarBaja(solicitud.Id, motivo, sesion)
  VB -> VB : ValidarMotivo(motivo)\n(recorta; 1 a 200 caracteres)

  alt 25c. motivo inválido (vacío o de más de 200 caracteres)
    VB --> FA : throw InvalidOperationException\n("Debe indicar el motivo del rechazo." /\n"El motivo del rechazo no puede superar los 200 caracteres.")
  else motivo válido (motivoLimpio)
    VB -> VB : ObtenerSolicitudPendiente(solicitudId, TipoSolicitud.Baja)
    VB -> SD : ObtenerPorId(solicitudId)
    SD -> DB : SOLICITUD_OBTENER_POR_ID(@id)
    DB --> SD : filas
    SD --> VB : SolicitudAutorizacion (o null)

    alt 25e. la solicitud no existe, ya fue resuelta o no es de baja
      VB --> FA : throw InvalidOperationException\n("La solicitud indicada no existe." / "La solicitud ya fue resuelta." /\n"La solicitud no corresponde a este trámite.")
    else solicitud pendiente de baja
      VB -> VB : ValidarSeparacionDeFunciones(s, sesion, "rechazar")

      alt 25a. el administrador es quien emitió la solicitud (RN-01, capa BLL)
        VB --> FA : throw InvalidOperationException\n("No puede rechazar una solicitud que usted mismo emitió.")
      else el administrador no es el emisor
        VB -> SD : RechazarBaja(s.Id, sesion.Id, motivoLimpio)
        SD -> DB : SOLICITUD_RECHAZAR_BAJA(@solicitud_id,@resolutor_id,@motivo)
        note right of DB : en una transacción: solicitud Rechazada con el motivo\n(WHERE EMISOR_ID <> @resolutor_id); el VINO sigue Activo
        DB --> SD : FILAS
        SD --> VB : int filas

        alt 25e. 0 filas (la solicitud cambió de estado o la emitió el administrador)
          VB --> FA : throw InvalidOperationException\n("No se pudo rechazar la baja: la solicitud cambió de estado o usted\nla emitió. Actualice e intente nuevamente.")
        else 1 fila
          VB -> BB : RegistrarAccion(sesion.Usuario,\n"RECHAZO_BAJA_VINO:" + s.VinoCodigo)
          BB -> TD : Registrar(usuario, accion)
          TD -> DB : BITACORA_INSERTAR(@usuario,@accion)
          DB --> TD : filas afectadas
          TD --> BB : void
          BB --> VB : void
          VB --> FA : void
          FA --> A : "Solicitud de descontinuación rechazada. El vino sigue activo."\n(título "Éxito")
          FA -> FA : txtMotivoRechazo.Clear()
          @LP Baja
        end
      end
    end
  end

  opt la BLL lanzó InvalidOperationException (catch de btnRechazarBaja_Click)
    FA --> A : ex.Message\n(título "Atención")
    @LP Baja
    note right of FA : return
  end
end
deactivate FA

@enduml
