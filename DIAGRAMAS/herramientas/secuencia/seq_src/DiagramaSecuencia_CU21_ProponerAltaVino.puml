@startuml DiagramaSecuencia_CU21_ProponerAltaVino

title CU-21 — Proponer Alta de Vino — Diagrama de Secuencia

skinparam shadowing false
skinparam roundcorner 6
skinparam sequenceArrowThickness 1.2
skinparam sequenceMessageAlign center
hide footbox
scale 0.7

actor       ":Usuario"             as U
participant ":frmCatalogoVinos"    as FC #FEFECE
participant ":VinoBLL"             as VB #E8F4E8
participant ":BitacoraBLL"         as BB #E8F4E8
participant ":BodegaDAL"           as BD #E8E8F4
participant ":VinoDAL"             as VD #E8E8F4
participant ":SolicitudAutorizacionDAL" as SD #E8E8F4
participant ":BitacoraDAL"         as TD #E8E8F4
database    ":DB"                  as DB #EEEEEE

note over FC
  Precondición: sesión activa; permiso "Gestionar catálogo de vinos".
  sesion = SessionManager.getInstance().getUsuario().
end note

U -> FC : menú Catálogo > "Gestionar catálogo de vinos"\n(new frmCatalogoVinos().ShowDialog())
activate FC
note right of FC
  Load: se registra en IdiomaManager, traduce sus controles,
  CargarBodegas(), CargarVinos() y agrega el selector de idiomas
end note

FC -> FC : CargarBodegas()
FC -> VB : ListarBodegas()
VB -> BD : ListarHabilitadas()
BD -> DB : BODEGA_LISTAR_HABILITADAS
DB --> BD : filas
BD --> VB : List<Bodega>
VB --> FC : List<Bodega>
FC -> FC : cboBodega.DataSource = bodegas;\nDisplayMember = Nombre; ValueMember = Id;\nSelectedIndex = 0 solo si hay bodegas

@LC
note right of DB
  VINO_LISTAR_CATALOGO devuelve los vinos Activos y Rechazados de todos,
  más los Pendientes cuya última solicitud emitió @usuario_id (los
  Descontinuados quedan ocultos), con tipo, estado y motivo de la
  última solicitud
end note
FC --> U : grilla con estado y última solicitud\n(btnReproponer solo con vino Rechazado; btnSolicitarBaja\nsolo con vino Activo sin baja pendiente)

alt el usuario propone un vino nuevo
  U -> FC : completar SKU, nombre, bodega, varietal, añada,\nprecio, stock mínimo (maridaje y puntaje opcionales)\n+ click "Proponer alta"
  FC -> VB : ProponerAlta(vino, sesion)
  VB -> VB : ValidarDatos(vino, exigirCodigo = true)

  alt 21a. algún dato no cumple las validaciones de negocio
    VB --> FC : throw InvalidOperationException\n("El SKU es obligatorio." / "El nombre es obligatorio." /\n"Debe seleccionar una bodega válida." / "El varietal es obligatorio." /\n"El año de añada no es válido." / "El precio debe ser mayor a cero." /\n"El stock mínimo no puede ser negativo." /\n"El puntaje debe estar entre 0 y 100.")
  else datos válidos
    VB -> VD : ObtenerPorCodigo(vino.Codigo)
    VD -> DB : VINO_OBTENER_POR_CODIGO(@codigo)
    DB --> VD : filas
    VD --> VB : Vino (o null)

    alt 21c. el SKU corresponde a un vino rechazado (existente.Estado == Rechazado)
      VB --> FC : throw InvalidOperationException\n("El SKU indicado corresponde a un vino rechazado. Seleccione ese vino\nen el catálogo y use 'Corregir y reproponer'.")
    else 21b. ya existe un vino con el SKU indicado (otro estado)
      VB --> FC : throw InvalidOperationException\n("Ya existe un vino con el SKU indicado.")
    else SKU disponible
      VB -> VB : vino.CreadoPor = sesion.Id; vino.Estado = Pendiente
      VB -> VD : Insertar(vino)
      VD -> DB : VINO_INSERTAR(@codigo,@nombre,@bodega_id,@varietal,\n@aniada,@stock_minimo,@creado_por,@precio,@maridaje,@puntaje)
      note right of DB : en una sola transacción: INSERT VINO (Pendiente)\n+ INSERT SOLICITUD_AUTORIZACION (ALTA, Pendiente)

      alt 21f. la bodega no existe (SqlException 547)
        DB --> VD : SqlException
        VD --> VB : SqlException
        VB --> FC : throw InvalidOperationException\n("Debe seleccionar una bodega válida.")
      else 21f. el SKU se duplicó en una carrera (SqlException 2601 / 2627)
        DB --> VD : SqlException
        VD --> VB : SqlException
        VB --> FC : throw InvalidOperationException\n("Ya existe un vino con el SKU indicado.")
      else inserción correcta
        DB --> VD : ID del vino creado (SELECT @id AS ID;\nla DAL lo descarta: Escribir usa ExecuteNonQuery)
        VD --> VB : void
        VB -> BB : RegistrarAccion(sesion.Usuario, "ALTA_VINO:" + vino.Codigo)
        BB -> TD : Registrar(usuario, accion)
        TD -> DB : BITACORA_INSERTAR(@usuario,@accion)
        DB --> TD : filas afectadas
        TD --> BB : void
        BB --> VB : void
        VB --> FC : void
        FC --> U : "Vino propuesto correctamente. Queda pendiente de autorización."\n(título "Éxito")
        FC -> FC : LimpiarFormulario()
        @LC
      end
    end
  end

else 21d. el usuario corrige un vino rechazado
  U -> FC : seleccionar un vino + click "Corregir y reproponer"

  break 21g. el vino no está seleccionado o no está Rechazado
    FC --> U : "Seleccione un vino rechazado."\n(título "Atención")
    note right of FC : return: no carga nada ni recarga la grilla
  end

  FC -> FC : LimpiarFormulario(); cargar el vino en el formulario\n(SKU de solo lectura, _vinoReproponerId = vino.Id)
  U -> FC : corregir los datos + click "Proponer alta"
  FC -> FC : v.Id = _vinoReproponerId
  FC -> VB : Reproponer(vino, sesion)
  VB -> VB : ValidarDatos(vino, exigirCodigo = false)

  alt 21e. algún dato no cumple las validaciones de negocio
    VB --> FC : throw InvalidOperationException\n(mensaje de la validación)
  else datos válidos
    VB -> VD : ObtenerPorId(vino.Id)
    VD -> DB : VINO_OBTENER_POR_ID(@id)
    DB --> VD : filas
    VD --> VB : Vino (o null)

    alt 21e. el vino no existe o ya no está Rechazado
      VB --> FC : throw InvalidOperationException\n("El vino indicado no existe." /\n"Solo se puede reproponer un vino rechazado.")
    else vino Rechazado
      VB -> SD : ObtenerPendiente(actual.Id, TipoSolicitud.Alta)
      SD -> DB : SOLICITUD_OBTENER_PENDIENTE(@vino_id,@tipo)
      DB --> SD : filas
      SD --> VB : SolicitudAutorizacion (o null)

      alt 21e. ya existe una solicitud de alta pendiente
        VB --> FC : throw InvalidOperationException\n("El vino ya tiene una solicitud de alta pendiente de autorización.")
      else sin solicitud pendiente
        VB -> VD : Reproponer(vino, sesion.Id)
        VD -> DB : VINO_REPROPONER(@id,@nombre,@bodega_id,@varietal,@aniada,\n@stock_minimo,@emisor_id,@precio,@maridaje,@puntaje)
        note right of DB : en una sola transacción: UPDATE VINO a Pendiente\nWHERE ESTADO = 'Rechazado' + INSERT SOLICITUD_AUTORIZACION\n(ALTA, Pendiente, emisor = quien repropone)

        alt 21e. la bodega no existe (SqlException 547)
          DB --> VD : SqlException
          VD --> VB : SqlException
          VB --> FC : throw InvalidOperationException\n("Debe seleccionar una bodega válida.")
        else 21e. otra re-propuesta se adelantó (SqlException 2601 / 2627)
          DB --> VD : SqlException
          VD --> VB : SqlException
          VB --> FC : throw InvalidOperationException\n("El vino ya tiene una solicitud de alta pendiente de autorización.")
        else el SP responde
          DB --> VD : FILAS
          VD --> VB : int filas

          alt 21e. 0 filas (el vino ya no está rechazado)
            VB --> FC : throw InvalidOperationException\n("No se pudo reproponer: el vino ya no está rechazado.\nActualice e intente nuevamente.")
          else 1 fila
            VB -> BB : RegistrarAccion(sesion.Usuario,\n"REPROPUESTA_ALTA_VINO:" + actual.Codigo)
            BB -> TD : Registrar(usuario, accion)
            TD -> DB : BITACORA_INSERTAR(@usuario,@accion)
            DB --> TD : filas afectadas
            TD --> BB : void
            BB --> VB : void
            VB --> FC : void
            FC --> U : "Vino repropuesto correctamente. Se emitió una nueva solicitud de alta,\npendiente de autorización." (título "Éxito")
            FC -> FC : LimpiarFormulario()
            @LC
          end
        end
      end
    end
  end
end

opt la BLL lanzó InvalidOperationException (catch de btnGuardarVino_Click)
  FC --> U : ex.Message\n(título "Atención")
  opt es una re-propuesta (esReproposicion)
    @LC
    note right of FC : el vino puede haber cambiado de estado; el formulario\nqueda en modo re-propuesta (no se limpia)
  end
  note right of FC : en el alta nueva no se recarga la grilla (return)
end
deactivate FC

@enduml
