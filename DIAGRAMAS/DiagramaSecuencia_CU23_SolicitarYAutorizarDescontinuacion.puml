@startuml DiagramaSecuencia_CU23_SolicitarYAutorizarDescontinuacion

title CU-23 — Solicitar y Autorizar Descontinuación de Vino — Diagrama de Secuencia

skinparam shadowing false
skinparam roundcorner 6
skinparam sequenceArrowThickness 1.2
skinparam ParticipantPadding 14
skinparam sequenceMessageAlign center
hide footbox
scale 0.8

actor       ":Usuario"              as U
participant ":frmCatalogoVinos"     as FC #FEFECE
participant ":VinoBLL"              as VB #E8F4E8
database    ":DB"                   as DB #E8E8F4
actor       ":Administrador"        as A
participant ":frmAutorizarVinos"    as FA #FEFECE

note over FC
  Precondición: sesión activa,
  permiso "Gestionar catálogo de vinos".
end note

== 1. Solicitud de descontinuación ==

U -> FC : seleccionar vino activo + click\n"Solicitar descontinuación"
activate FC
FC -> VB : SolicitarBaja(vinoId, solicitanteId)
activate VB
VB -> DB : VINO_SOLICITAR_BAJA(vinoId, solicitanteId,\nFECHA_SOLICITUD_BAJA = ahora)
DB --> VB : OK
VB --> FC : true
deactivate VB
FC --> U : "Descontinuación solicitada,\npendiente de autorización."
deactivate FC

== 2. Autorización de la descontinuación ==

A -> FA : abrir "Descontinuaciones pendientes"
activate FA
FA -> VB : ListarPendientesDeBaja()
VB -> DB : VINO_LISTAR_PENDIENTES_BAJA
DB --> VB : filas con BAJA_SOLICITADA_POR IS NOT NULL\nAND DESCONTINUADO_POR IS NULL
VB --> FA : List<Vino>
FA -> FA : refrescar grilla

A -> FA : seleccionar vino + click "Autorizar baja"
FA -> VB : AutorizarBaja(vinoId, administradorId)
activate VB

alt 6a. el administrador es el mismo que solicitó la baja (RN-01)
  VB --> FA : InvalidOperationException
  FA --> A : "No podés autorizar una descontinuación\nque vos mismo solicitaste."
  note right of FA : el flujo vuelve al paso 5
else separación de funciones OK
  VB -> DB : VINO_AUTORIZAR_BAJA(vinoId, administradorId,\nESTADO = 'Descontinuado',\nFECHA_DESCONTINUACION = ahora)
  DB --> VB : OK
  VB --> FA : true
  deactivate VB
  FA --> A : "Vino descontinuado. Ya no aparece\nen el catálogo vendible."
  deactivate FA
end

@enduml
