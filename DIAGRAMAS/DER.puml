@startuml DER - BDCAPAS

skinparam linetype ortho
hide empty methods

entity USUARIO {
  * ID : INT <<PK>>
  --
  USUARIO : VARCHAR(50) <<nullable>>
  PASS : VARCHAR(64) <<nullable>>
  INTENTOS_FALLIDOS : INT
  BLOQUEADO : BIT
  ROL : VARCHAR(20)
  ROL_ID : INT <<FK, nullable>>
  DVH : INT
  NOMBRE : VARCHAR(50) <<nullable>>
  APELLIDO : VARCHAR(50) <<nullable>>
  IDIOMA_ID : INT <<FK, nullable>>
  TELEFONO : VARCHAR(30) <<nullable>>
  EMAIL : VARCHAR(100) <<nullable>>
}

entity ROL {
  * ID : INT <<PK>>
  --
  NOMBRE : VARCHAR(100)
  PADRE_ID : INT <<FK, nullable>>
  PROTEGIDO : BIT
}

entity PERMISO {
  * ID : INT <<PK>>
  --
  NOMBRE : VARCHAR(100)
}

entity USUARIO_PERFIL {
  * USUARIO_ID : INT <<PK>>
  * PERFIL_ID : INT <<PK, FK>>
}

entity ROL_PERMISO {
  * ROL_ID : INT <<PK, FK>>
  * PERMISO_ID : INT <<PK, FK>>
}

entity BITACORA {
  * ID : INT <<PK>>
  --
  USUARIO : VARCHAR(50) <<nullable>>
  ACCION : VARCHAR(50) <<nullable>>
  FECHA : DATETIME <<nullable>>
}

entity IDIOMA {
  * ID : INT <<PK>>
  --
  NOMBRE : VARCHAR(50)
  HABILITADO : BIT
  PREDETERMINADO : BIT
}

entity CONTROL_IDIOMA {
  * ID : INT <<PK>>
  --
  CLAVE : VARCHAR(100)
  TEXTO_DEFAULT : VARCHAR(200)
}

entity TRADUCCION {
  * IDIOMA_ID : INT <<PK, FK>>
  * CONTROL_ID : INT <<PK, FK>>
  --
  TEXTO : VARCHAR(200)
}

entity USUARIO_HISTORIAL {
  * ID : INT <<PK>>
  --
  USUARIO_ID : INT
  USUARIO_LOGIN : VARCHAR(50)
  ROL : VARCHAR(20)
  ROL_ID : INT <<nullable>>
  BLOQUEADO : BIT
  INTENTOS_FALLIDOS : INT
  PERFILES : VARCHAR(500)
  NOMBRE : VARCHAR(50) <<nullable>>
  APELLIDO : VARCHAR(50) <<nullable>>
  TELEFONO : VARCHAR(30) <<nullable>>
  EMAIL : VARCHAR(100) <<nullable>>
  FECHA_CAMBIO : DATETIME
  REALIZADO_POR : VARCHAR(50)
  TIPO_CAMBIO : VARCHAR(25)
  VERSION_ORIGEN : INT <<nullable>>
}

entity DIGITO_VERIFICADOR_VERTICAL {
  * TABLA : VARCHAR(50) <<PK>>
  * COLUMNA : VARCHAR(50) <<PK>>
  --
  DVV : INT
}

entity BODEGA {
  * ID : INT <<PK>>
  --
  NOMBRE : VARCHAR(100) <<unique>>
  PAIS : VARCHAR(50)
  REGION : VARCHAR(50) <<nullable>>
  HABILITADO : BIT
}

entity VINO {
  * ID : INT <<PK>>
  --
  CODIGO : VARCHAR(20) <<unique>>
  NOMBRE : VARCHAR(100)
  BODEGA_ID : INT <<FK>>
  VARIETAL : VARCHAR(50)
  ANIADA : INT
  PRECIO : DECIMAL(10,2)
  STOCK_MINIMO : INT
  ESTADO : VARCHAR(15) <<Pendiente, Activo, Rechazado, Descontinuado>>
  MARIDAJE : VARCHAR(200) <<nullable>>
  PUNTAJE : INT <<nullable>>
  CREADO_POR : INT <<FK>>
  FECHA_ALTA : DATETIME
}

entity SOLICITUD_AUTORIZACION {
  * ID : INT <<PK>>
  --
  TIPO : VARCHAR(10) <<ALTA, BAJA>>
  VINO_ID : INT <<FK>>
  ESTADO : VARCHAR(10) <<Pendiente, Aprobada, Rechazada>>
  EMISOR_ID : INT <<FK>>
  FECHA_EMISION : DATETIME
  RESOLUTOR_ID : INT <<FK, nullable>>
  FECHA_RESOLUCION : DATETIME <<nullable>>
  MOTIVO_RECHAZO : VARCHAR(200) <<nullable>>
}

note bottom of SOLICITUD_AUTORIZACION
  UQ filtrado (VINO_ID, TIPO) WHERE ESTADO = 'Pendiente'
  CK: RESOLUTOR_ID <> EMISOR_ID (RN-01)
end note

entity MOVIMIENTO_STOCK {
  * ID : INT <<PK>>
  --
  VINO_ID : INT <<FK>>
  FECHA : DATETIME
  TIPO : VARCHAR(10)
  CANTIDAD : INT
  MOTIVO : VARCHAR(100)
  RESPONSABLE : VARCHAR(50)
  REFERENCIA_TIPO : VARCHAR(20) <<nullable>>
  REFERENCIA_ID : INT <<nullable>>
}

USUARIO        ..o{ USUARIO_PERFIL  : "referencia logica (sin FK) >"
ROL            ||--o{ USUARIO_PERFIL  : "< rol asignado a"
ROL            ||--o{ ROL_PERMISO     : "ROL_ID >"
PERMISO        ||--o{ ROL_PERMISO     : "< PERMISO_ID"
ROL            ||--o{ ROL             : "PADRE_ID (autoref) >"
ROL            ||--o{ USUARIO         : "ROL_ID >"
IDIOMA         ||--o{ USUARIO         : "IDIOMA_ID >"
IDIOMA         ||--o{ TRADUCCION      : "tiene >"
CONTROL_IDIOMA ||--o{ TRADUCCION      : "< traduce"

USUARIO        ..o{ USUARIO_HISTORIAL : "referencia logica >"

BODEGA  ||--o{ VINO             : "BODEGA_ID >"
VINO    ||--o{ MOVIMIENTO_STOCK : "VINO_ID >"
USUARIO ||--o{ VINO             : "CREADO_POR >"
VINO    ||--o{ SOLICITUD_AUTORIZACION : "VINO_ID >"
USUARIO ||--o{ SOLICITUD_AUTORIZACION : "EMISOR_ID >"
USUARIO |o--o{ SOLICITUD_AUTORIZACION : "RESOLUTOR_ID >"

' ─────────────────────────────────────────
' Dominio: Curación y Armado de Cajas Mensuales (N02)
' ─────────────────────────────────────────

entity SOCIO {
  * ID : INT <<PK>>
  --
  NOMBRE : VARCHAR(50)
  APELLIDO : VARCHAR(50)
  EMAIL : VARCHAR(100) <<nullable>>
  TELEFONO : VARCHAR(20) <<nullable>>
  DOMICILIO : VARCHAR(150) <<nullable>>
  PRESUPUESTO_MENSUAL : DECIMAL(10,2)
  ACTIVO : BIT
  FECHA_ALTA : DATETIME
  CREADO_POR : INT <<FK>>
}

entity SOCIO_VARIETAL {
  * SOCIO_ID : INT <<PK, FK>>
  * VARIETAL : VARCHAR(50) <<PK>>
}

entity CAJA_MENSUAL {
  * ID : INT <<PK>>
  --
  SOCIO_ID : INT <<FK>>
  PERIODO : CHAR(7)
  ESTADO : VARCHAR(12)
  PRESUPUESTO_SNAPSHOT : DECIMAL(10,2)
  FECHA_ARMADO : DATETIME
  ARMADO_POR : INT <<FK>>
  FECHA_DESPACHO : DATETIME <<nullable>>
  DESPACHADO_POR : INT <<FK, nullable>>
  FECHA_CANCELACION : DATETIME <<nullable>>
  CANCELADA_POR : INT <<FK, nullable>>
  MOTIVO_CANCELACION : VARCHAR(200) <<nullable>>
}
note bottom of CAJA_MENSUAL
  UQ (SOCIO_ID, PERIODO) WHERE ESTADO <> 'Cancelada'
end note

entity CAJA_VINO {
  * ID : INT <<PK>>
  --
  CAJA_ID : INT <<FK>>
  VINO_ID : INT <<FK>>
  CANTIDAD : INT
  NOMBRE_SNAPSHOT : VARCHAR(100)
  PRECIO_SNAPSHOT : DECIMAL(10,2)
}
note bottom of CAJA_VINO
  UQ (CAJA_ID, VINO_ID)
end note

entity SUSTITUCION {
  * ID : INT <<PK>>
  --
  CAJA_VINO_ID : INT <<FK>>
  VINO_ORIGINAL_ID : INT <<FK>>
  VINO_REEMPLAZO_ID : INT <<FK>>
  NOMBRE_SNAPSHOT : VARCHAR(100)
  PRECIO_SNAPSHOT : DECIMAL(10,2)
  MOTIVO : VARCHAR(200)
  RESPONSABLE_ID : INT
  FECHA : DATETIME
}

SOCIO        ||--o{ SOCIO_VARIETAL : "SOCIO_ID >"
SOCIO        ||--o{ CAJA_MENSUAL   : "SOCIO_ID >"
CAJA_MENSUAL ||--o{ CAJA_VINO      : "CAJA_ID >"
VINO         ||--o{ CAJA_VINO      : "VINO_ID >"
CAJA_VINO    ||--o{ SUSTITUCION    : "CAJA_VINO_ID >"
VINO         ||--o{ SUSTITUCION    : "VINO_ORIGINAL_ID >"
VINO         ||--o{ SUSTITUCION    : "VINO_REEMPLAZO_ID >"
USUARIO      ||--o{ SOCIO          : "CREADO_POR >"
USUARIO      ||--o{ CAJA_MENSUAL   : "ARMADO_POR / DESPACHADO_POR / CANCELADA_POR >"
USUARIO      ..o{ SUSTITUCION    : "RESPONSABLE_ID (referencia logica, sin FK) >"
CAJA_MENSUAL ..o{ MOVIMIENTO_STOCK : "REFERENCIA_TIPO='CAJA', REFERENCIA_ID (soft link, RN-09)"

' ─────────────────────────────────────────
' Dominio: Pedido de Reposición (N03)
' ─────────────────────────────────────────

entity PEDIDO_REPOSICION {
  * ID : INT <<PK>>
  --
  BODEGA_ID : INT <<FK>>
  ESTADO : VARCHAR(10) <<Pendiente, Aprobado, Rechazado, Recibido>>
  FECHA_CREACION : DATETIME
  CREADO_POR : INT <<FK>>
  RESOLUTOR_ID : INT <<FK, nullable>>
  FECHA_RESOLUCION : DATETIME <<nullable>>
  MOTIVO_RECHAZO : VARCHAR(200) <<nullable>>
  RECIBIDO_POR : INT <<FK, nullable>>
  FECHA_RECEPCION : DATETIME <<nullable>>
  OBSERVACION : VARCHAR(200) <<nullable>>
}
note bottom of PEDIDO_REPOSICION
  IX_PEDREP_ESTADO (ESTADO)
  CK: RESOLUTOR_ID <> CREADO_POR (RN-33)
  CK: motivo de 1 a 200 solo si Rechazado (RN-34)
  CK: recepción solo si Recibido (RN-35)
end note

entity PEDIDO_REPOSICION_LINEA {
  * ID : INT <<PK>>
  --
  PEDIDO_ID : INT <<FK>>
  VINO_ID : INT <<FK>>
  CANTIDAD_SUGERIDA : INT
  CANTIDAD_PEDIDA : INT
  CANTIDAD_RECIBIDA : INT <<nullable>>
  ABIERTO : BIT
}
note bottom of PEDIDO_REPOSICION_LINEA
  UQ (PEDIDO_ID, VINO_ID)
  UX_PEDREPLIN_VINO_ABIERTO: único filtrado (VINO_ID) WHERE ABIERTO = 1 (RN-32)
  CK: PEDIDA > 0; 0 <= RECIBIDA <= PEDIDA
end note

BODEGA                   ||--o{ PEDIDO_REPOSICION       : "BODEGA_ID >"
USUARIO                  ||--o{ PEDIDO_REPOSICION       : "CREADO_POR >"
USUARIO                  |o--o{ PEDIDO_REPOSICION       : "RESOLUTOR_ID >"
USUARIO                  |o--o{ PEDIDO_REPOSICION       : "RECIBIDO_POR >"
PEDIDO_REPOSICION        ||--o{ PEDIDO_REPOSICION_LINEA : "PEDIDO_ID >"
VINO                     ||--o{ PEDIDO_REPOSICION_LINEA : "VINO_ID >"
PEDIDO_REPOSICION        ..o{ MOVIMIENTO_STOCK          : "soft link (RN-35)"

@enduml
